// Ascend C PSP-KV codecs, reference kernels, tiled UB dequantization and
// streaming SIMD attention. Scalar fallbacks preserve the wider mixed-format
// contract; the FP8 tile paths avoid per-element scalar codec operations.

#include <ATen/ATen.h>
#include <c10/core/DeviceGuard.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "kernel_operator.h"

#include <algorithm>
#include <cstdint>
#include <limits>
#include <tuple>

__aicore__ inline uint8_t EncodeE4M3(uint32_t bits) {
    const uint32_t sign = (bits >> 31) & 1;
    const uint32_t magnitude = bits & 0x7fffffffU;
    int32_t exponent = static_cast<int32_t>((magnitude >> 23) & 0xff) - 127 + 7;
    const uint32_t fraction = magnitude & 0x7fffffU;
    uint32_t mantissa = fraction >> 20;
    const uint32_t round_bit = (fraction >> 19) & 1;
    const bool sticky = (fraction & 0x7ffffU) != 0;
    mantissa += round_bit && (sticky || (mantissa & 1));
    exponent += static_cast<int32_t>(mantissa >> 3);
    mantissa &= 7;
    uint32_t encoded;
    if (exponent <= 0) {
        const int32_t shift = exponent < -30 ? 31 : 1 - exponent;
        encoded = (sign << 7) | (((8 | mantissa) >> shift) & 7);
    } else {
        encoded = (sign << 7) | (static_cast<uint32_t>(exponent) << 3) | mantissa;
    }
    if (exponent < -7) encoded = sign << 7;
    if (exponent >= 15) encoded = (sign << 7) | 0x78;
    if (magnitude == 0) encoded = 0;
    if (magnitude == 0x7f800000U) encoded = (sign << 7) | 0x78;
    if (magnitude > 0x7f800000U) encoded = 0x7f;
    return static_cast<uint8_t>(encoded);
}

__aicore__ inline uint8_t EncodeE5M2(uint32_t bits) {
    const uint32_t sign = (bits >> 31) & 1;
    const uint32_t magnitude = bits & 0x7fffffffU;
    int32_t exponent = static_cast<int32_t>((magnitude >> 23) & 0xff) - 127 + 15;
    const uint32_t fraction = magnitude & 0x7fffffU;
    uint32_t mantissa = fraction >> 21;
    const uint32_t round_bit = (fraction >> 20) & 1;
    const bool sticky = (fraction & 0xfffffU) != 0;
    mantissa += round_bit && (sticky || (mantissa & 1));
    exponent += static_cast<int32_t>(mantissa >> 2);
    mantissa &= 3;
    uint32_t encoded;
    if (exponent <= 0) {
        const int32_t shift = exponent < -30 ? 31 : 1 - exponent;
        encoded = (sign << 7) | (((4 | mantissa) >> shift) & 3);
    } else {
        encoded = (sign << 7) | (static_cast<uint32_t>(exponent) << 2) | mantissa;
    }
    if (exponent < -1) encoded = sign << 7;
    if (exponent >= 31) encoded = (sign << 7) | 0x7c;
    if (magnitude == 0) encoded = 0;
    if (magnitude == 0x7f800000U) encoded = (sign << 7) | 0x7c;
    if (magnitude > 0x7f800000U) encoded = 0x7f;
    return static_cast<uint8_t>(encoded);
}

__aicore__ inline uint8_t EncodeE2M1(uint32_t bits) {
    const uint32_t sign = (bits >> 31) & 1;
    const uint32_t magnitude = bits & 0x7fffffffU;
    int32_t exponent = static_cast<int32_t>((magnitude >> 23) & 0xff) - 126;
    const uint32_t fraction = magnitude & 0x7fffffU;
    uint32_t mantissa = fraction >> 22;
    const uint32_t round_bit = (fraction >> 21) & 1;
    const bool sticky = (fraction & 0x1fffffU) != 0;
    mantissa += round_bit && (sticky || (mantissa & 1));
    exponent += static_cast<int32_t>(mantissa >> 1);
    mantissa &= 1;
    uint32_t encoded;
    if (exponent <= 0) {
        const int32_t shift = exponent < -30 ? 31 : 1 - exponent;
        encoded = (sign << 3) | (((2 | mantissa) >> shift) & 1);
    } else {
        encoded = (sign << 3) | (static_cast<uint32_t>(exponent) << 1) | mantissa;
    }
    if (exponent < -1) encoded = sign << 3;
    if (exponent >= 3) encoded = (sign << 3) | 6;
    if (magnitude == 0) encoded = 0;
    if (magnitude == 0x7f800000U) encoded = (sign << 3) | 6;
    if (magnitude > 0x7f800000U) encoded = 7;
    return static_cast<uint8_t>(encoded);
}

__aicore__ inline float DecodeFP8(uint8_t encoded, uint8_t format) {
    const uint32_t sign = encoded >> 7;
    const uint32_t exponent = format == 2 ? (encoded >> 2) & 31 : (encoded >> 3) & 15;
    const uint32_t mantissa = format == 2 ? encoded & 3 : encoded & 7;
    uint32_t bits;
    if (exponent == 0) {
        const float unit = format == 2 ? 1.0f / 65536.0f : 1.0f / 512.0f;
        float value = 0.0f;
        if (mantissa & 1) value += unit;
        if (mantissa & 2) value += 2.0f * unit;
        if (mantissa & 4) value += 4.0f * unit;
        return sign ? -value : value;
    }
    if (format == 2 && exponent == 31) {
        bits = mantissa == 0 ? 0x7f800000U : 0x7fc00000U;
    } else if (format == 1 && exponent == 15 && mantissa == 7) {
        bits = 0x7fc00000U;
    } else {
        bits = ((exponent + (format == 2 ? 112 : 120)) << 23)
             | (mantissa << (format == 2 ? 21 : 20));
    }
    bits |= sign << 31;
    union { uint32_t u; float f; } converted;
    converted.u = bits;
    return converted.f;
}

__aicore__ inline float DecodeHalf(uint16_t encoded) {
    const uint32_t sign = static_cast<uint32_t>(encoded >> 15) << 31;
    const uint32_t exponent = (encoded >> 10) & 31;
    const uint32_t mantissa = encoded & 1023;
    if (exponent == 0) {
        float value = 0.0f;
        float unit = 1.0f / 16777216.0f;
        for (uint32_t bit = 0; bit < 10; ++bit) {
            if (mantissa & (1U << bit)) value += unit;
            unit *= 2.0f;
        }
        return sign ? -value : value;
    }
    union { uint32_t u; float f; } converted;
    converted.u = sign | (exponent == 31 ? 0x7f800000U
                                        : (exponent + 112) << 23)
                       | (mantissa << 13);
    return converted.f;
}

__aicore__ inline float DecodeFP4(uint8_t encoded) {
    const uint8_t nibble = encoded & 15;
    const uint8_t exponent = (nibble >> 1) & 3;
    const uint8_t mantissa = nibble & 1;
    float value;
    if (exponent == 0) value = mantissa ? 0.5f : 0.0f;
    else if (exponent == 1) value = mantissa ? 1.5f : 1.0f;
    else if (exponent == 2) value = mantissa ? 3.0f : 2.0f;
    else {
        union { uint32_t u; float f; } infinity;
        infinity.u = 0x7f800000U;
        value = infinity.f;
    }
    return nibble & 8 ? -value : value;
}

// target_dtype: 0=BF16, 1=FP16, 2=FP8 E4M3, 3=FP8 E5M2.
__aicore__ inline float ReadTarget(AscendC::GlobalTensor<uint8_t>& bytes,
                                   uint32_t element, uint32_t target_dtype) {
    if (target_dtype >= 2) {
        return DecodeFP8(bytes.GetValue(element), target_dtype == 3 ? 2 : 1);
    }
    const uint16_t raw = static_cast<uint16_t>(bytes.GetValue(2 * element))
                       | (static_cast<uint16_t>(bytes.GetValue(2 * element + 1)) << 8);
    if (target_dtype == 1) return DecodeHalf(raw);
    union { uint32_t u; float f; } converted;
    converted.u = static_cast<uint32_t>(raw) << 16;
    return converted.f;
}

__aicore__ inline uint32_t PackedBytesPerHead(uint8_t format,
                                               uint32_t block_size,
                                               uint32_t head_dim,
                                               uint32_t target_dtype) {
    const uint32_t elements = block_size * head_dim;
    if (format == 0) return elements * (target_dtype >= 2 ? 1 : 2);
    return format == 3 ? elements / 2 : elements;
}

// Legacy metadata has one shared K/V scale per page and KV head. Scaled-basic
// may instead use independent K/V scales for each contiguous dimension group.
__aicore__ inline uint32_t PackedScaleIndex(
    uint32_t physical, uint32_t stream, uint32_t head, uint32_t dim,
    uint32_t kv_heads, uint32_t head_dim, uint32_t scale_groups) {
    if (scale_groups == 0) return physical * kv_heads + head;
    const uint32_t group_size = head_dim / scale_groups;
    return ((physical * 2 + stream) * kv_heads + head) * scale_groups
         + dim / group_size;
}

__aicore__ inline float ReadPacked(AscendC::GlobalTensor<uint8_t>& cache,
                                   uint32_t byte_base, uint32_t element,
                                   uint8_t format, uint32_t target_dtype,
                                   float scale) {
    if (format == 0) {
        if (target_dtype >= 2) {
            return DecodeFP8(cache.GetValue(byte_base + element),
                             target_dtype == 3 ? 2 : 1);
        }
        const uint16_t raw = static_cast<uint16_t>(
            cache.GetValue(byte_base + 2 * element))
            | (static_cast<uint16_t>(
                cache.GetValue(byte_base + 2 * element + 1)) << 8);
        if (target_dtype == 1) return DecodeHalf(raw);
        union { uint32_t u; float f; } converted;
        converted.u = static_cast<uint32_t>(raw) << 16;
        return converted.f;
    }
    if (format == 3) {
        const uint8_t packed = cache.GetValue(byte_base + element / 2);
        return DecodeFP4(element & 1 ? packed >> 4 : packed) * scale;
    }
    return DecodeFP8(cache.GetValue(byte_base + element), format) * scale;
}

__aicore__ inline void WritePacked(AscendC::GlobalTensor<uint8_t>& source,
                                   AscendC::GlobalTensor<uint8_t>& cache,
                                   uint32_t source_element, uint32_t base,
                                   uint32_t element, uint8_t format,
                                   uint32_t target_dtype, float scale) {
    const uint32_t scalar_bytes = target_dtype >= 2 ? 1 : 2;
    if (format == 0) {
        for (uint32_t byte = 0; byte < scalar_bytes; ++byte) {
            cache.SetValue(base + element * scalar_bytes + byte,
                           source.GetValue(source_element * scalar_bytes + byte));
        }
        return;
    }
    const float value = ReadTarget(source, source_element, target_dtype) / scale;
    union { float f; uint32_t u; } converted;
    converted.f = value;
    if (format == 3) {
        const uint32_t byte_position = base + element / 2;
        const uint8_t nibble = EncodeE2M1(converted.u);
        const uint8_t old = cache.GetValue(byte_position);
        cache.SetValue(byte_position, element & 1
            ? static_cast<uint8_t>((old & 15) | (nibble << 4))
            : static_cast<uint8_t>((old & 240) | nibble));
        return;
    }
    cache.SetValue(base + element,
                   format == 2 ? EncodeE5M2(converted.u)
                               : EncodeE4M3(converted.u));
}

// One logical element per loop iteration; the index arithmetic is explicit so
// the kernel can be checked against vLLM's slot_mapping and physical block IDs.
#include "pspkv_tiled.h"

__global__ __vector__ void PspkvQuantizeScatterBF16(
    GM_ADDR key, GM_ADDR value, GM_ADDR slots, GM_ADDR formats,
    GM_ADDR key_cache, GM_ADDR value_cache,
    uint32_t total, uint32_t elements_per_token, uint32_t block_size) {
    AscendC::GlobalTensor<uint16_t> k_in, v_in;
    AscendC::GlobalTensor<int64_t> slot_in;
    AscendC::GlobalTensor<uint8_t> fmt_in, k_out, v_out;
    k_in.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(key), total);
    v_in.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(value), total);
    slot_in.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(slots), total / elements_per_token);
    fmt_in.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(formats));
    k_out.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(key_cache));
    v_out.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(value_cache));
    // Give each AI Core a contiguous, 256-element-aligned region. Scattering
    // neighboring uint8 elements from different cores can race when the
    // device implements narrow global-memory stores as wider updates.
    constexpr uint32_t ELEMENTS_PER_CHUNK = 256;
    for (uint32_t chunk = AscendC::GetBlockIdx();
         chunk * ELEMENTS_PER_CHUNK < total;
         chunk += AscendC::GetBlockNum()) {
        const uint32_t start = chunk * ELEMENTS_PER_CHUNK;
        const uint32_t stop = start + ELEMENTS_PER_CHUNK < total
                                  ? start + ELEMENTS_PER_CHUNK : total;
        for (uint32_t index = start; index < stop; ++index) {
            const int64_t slot = slot_in.GetValue(index / elements_per_token);
            const uint8_t format = fmt_in.GetValue(slot / block_size);
            const int64_t cache_index = slot * elements_per_token
                                      + index % elements_per_token;
            const uint32_t k_bits = static_cast<uint32_t>(k_in.GetValue(index)) << 16;
            const uint32_t v_bits = static_cast<uint32_t>(v_in.GetValue(index)) << 16;
            k_out.SetValue(cache_index, format == 2 ? EncodeE5M2(k_bits) : EncodeE4M3(k_bits));
            v_out.SetValue(cache_index, format == 2 ? EncodeE5M2(v_bits) : EncodeE4M3(v_bits));
        }
    }
}

__global__ __vector__ void PspkvDecodeFP8(
    GM_ADDR bytes, GM_ADDR formats, GM_ADDR output,
    uint32_t total, uint32_t elements_per_block) {
    AscendC::GlobalTensor<uint8_t> input, fmt_in;
    AscendC::GlobalTensor<float> result;
    input.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(bytes), total);
    fmt_in.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(formats), total / elements_per_block);
    result.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output), total);
    // The output is float32, but SetValue still writes back whole 64-byte
    // DCache lines. Keep neighboring output elements on the same AI Core.
    constexpr uint32_t ELEMENTS_PER_CHUNK = 256;
    for (uint32_t chunk = AscendC::GetBlockIdx();
         chunk * ELEMENTS_PER_CHUNK < total;
         chunk += AscendC::GetBlockNum()) {
        const uint32_t start = chunk * ELEMENTS_PER_CHUNK;
        const uint32_t stop = start + ELEMENTS_PER_CHUNK < total
                                  ? start + ELEMENTS_PER_CHUNK : total;
        for (uint32_t index = start; index < stop; ++index) {
            const uint8_t format = fmt_in.GetValue(index / elements_per_block);
            result.SetValue(index, DecodeFP8(input.GetValue(index), format));
        }
    }
}

// Decode reads the physical FP8 pages directly. Score rows are padded to a
// 64-byte boundary so that neighboring AI Cores never share a DCache line.
__global__ __vector__ void PspkvDecodeScoresBF16(
    GM_ADDR query, GM_ADDR key_cache, GM_ADDR formats, GM_ADDR block_ids,
    GM_ADDR scores, uint32_t seq_len, uint32_t padded_seq_len,
    uint32_t block_size, uint32_t kv_heads, uint32_t head_dim,
    uint32_t heads, float scale) {
    AscendC::GlobalTensor<uint16_t> q;
    AscendC::GlobalTensor<uint8_t> keys, fmt;
    AscendC::GlobalTensor<int32_t> blocks;
    AscendC::GlobalTensor<float> out;
    q.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(query));
    keys.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(key_cache));
    fmt.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(formats));
    blocks.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(block_ids));
    out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scores));
    const uint32_t group_size = heads / kv_heads;
    for (uint32_t head = AscendC::GetBlockIdx();
         head < heads; head += AscendC::GetBlockNum()) {
        const uint32_t kv_head = head / group_size;
        const uint32_t score_base = head * padded_seq_len;
        for (uint32_t position = 0; position < seq_len; ++position) {
            const uint32_t physical = static_cast<uint32_t>(
                blocks.GetValue(position / block_size));
            const uint32_t offset = ((physical * block_size
                                    + position % block_size) * kv_heads
                                    + kv_head) * head_dim;
            const uint8_t format = fmt.GetValue(physical);
            float dot = 0.0f;
            for (uint32_t dim = 0; dim < head_dim; ++dim) {
                union { uint32_t u; float f; } q_value;
                q_value.u = static_cast<uint32_t>(
                    q.GetValue(head * head_dim + dim)) << 16;
                dot += q_value.f * DecodeFP8(keys.GetValue(offset + dim), format);
            }
            out.SetValue(score_base + position, dot * scale);
        }
        for (uint32_t position = seq_len; position < padded_seq_len;
             ++position) {
            out.SetValue(score_base + position, -3.402823466e38f);
        }
    }
}

__global__ __vector__ void PspkvDecodeWeightedValue(
    GM_ADDR probabilities, GM_ADDR value_cache, GM_ADDR formats,
    GM_ADDR block_ids, GM_ADDR output, uint32_t seq_len,
    uint32_t padded_seq_len, uint32_t block_size, uint32_t kv_heads,
    uint32_t head_dim, uint32_t heads) {
    AscendC::GlobalTensor<float> probs, out;
    AscendC::GlobalTensor<uint8_t> values, fmt;
    AscendC::GlobalTensor<int32_t> blocks;
    probs.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(probabilities));
    values.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(value_cache));
    fmt.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(formats));
    blocks.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(block_ids));
    out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output));
    const uint32_t group_size = heads / kv_heads;
    for (uint32_t head = AscendC::GetBlockIdx();
         head < heads; head += AscendC::GetBlockNum()) {
        const uint32_t kv_head = head / group_size;
        for (uint32_t dim = 0; dim < head_dim; ++dim) {
            float accumulator = 0.0f;
            for (uint32_t position = 0; position < seq_len; ++position) {
                const uint32_t physical = static_cast<uint32_t>(
                    blocks.GetValue(position / block_size));
                const uint32_t offset = ((physical * block_size
                                        + position % block_size) * kv_heads
                                        + kv_head) * head_dim + dim;
                const uint8_t format = fmt.GetValue(physical);
                accumulator += probs.GetValue(head * padded_seq_len + position)
                             * DecodeFP8(values.GetValue(offset), format);
            }
            out.SetValue(head * head_dim + dim, accumulator);
        }
    }
}

// PSP-KV's basic/enhanced/BTKV reference formats share one score kernel.
// Basic keeps V token-major; enhanced and BTKV transpose V within each head.
// The CUDA BTKV reference does not consume its TMA descriptors or apply a
// distinct tile swizzle, so format_generation=2 follows that same contract.
__global__ __vector__ void PspkvPackedScores(
    GM_ADDR query, GM_ADDR key_cache, GM_ADDR block_tables,
    GM_ADDR context_lens, GM_ADDR formats, GM_ADDR offsets,
    GM_ADDR scales, GM_ADDR scores, uint32_t num_seqs, uint32_t heads,
    uint32_t kv_heads, uint32_t head_dim, uint32_t block_size,
    uint32_t max_blocks, uint32_t target_dtype,
    uint32_t format_generation, uint32_t scale_groups,
    float softmax_scale) {
    AscendC::GlobalTensor<uint8_t> q, keys, fmt;
    AscendC::GlobalTensor<int32_t> blocks, lengths, byte_offsets;
    AscendC::GlobalTensor<float> per_head_scales, out;
    q.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(query));
    keys.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(key_cache));
    blocks.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(block_tables));
    lengths.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(context_lens));
    fmt.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(formats));
    byte_offsets.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(offsets));
    per_head_scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scales));
    out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scores));
    const uint32_t sequence_stride = max_blocks * block_size;
    for (uint32_t row = AscendC::GetBlockIdx();
         row < num_seqs * heads; row += AscendC::GetBlockNum()) {
        const uint32_t seq = row / heads;
        const uint32_t head = row % heads;
        const uint32_t kv_head = head / (heads / kv_heads);
        const uint32_t length = static_cast<uint32_t>(lengths.GetValue(seq));
        for (uint32_t position = 0; position < sequence_stride; ++position) {
            if (position >= length) {
                out.SetValue(row * sequence_stride + position, -3.402823466e38f);
                continue;
            }
            const uint32_t physical = static_cast<uint32_t>(blocks.GetValue(
                seq * max_blocks + position / block_size));
            const uint8_t format = fmt.GetValue(physical);
            const uint32_t per_head = PackedBytesPerHead(
                format, block_size, head_dim, target_dtype);
            const uint32_t base = static_cast<uint32_t>(byte_offsets.GetValue(physical))
                                + kv_head * per_head;
            float dot = 0.0f;
            for (uint32_t dim = 0; dim < head_dim; ++dim) {
                const float scale = format_generation == 0 || format == 0
                    ? 1.0f : per_head_scales.GetValue(PackedScaleIndex(
                        physical, 0, kv_head, dim, kv_heads, head_dim,
                        scale_groups));
                const float q_value = ReadTarget(q, row * head_dim + dim, target_dtype);
                const float k_value = ReadPacked(keys, base,
                    (position % block_size) * head_dim + dim,
                    format, target_dtype, scale);
                dot += q_value * k_value;
            }
            out.SetValue(row * sequence_stride + position, dot * softmax_scale);
        }
    }
}

__global__ __vector__ void PspkvPackedWeightedValue(
    GM_ADDR probabilities, GM_ADDR value_cache, GM_ADDR block_tables,
    GM_ADDR context_lens, GM_ADDR formats, GM_ADDR offsets,
    GM_ADDR scales, GM_ADDR output, uint32_t num_seqs, uint32_t heads,
    uint32_t kv_heads, uint32_t head_dim, uint32_t block_size,
    uint32_t max_blocks, uint32_t target_dtype,
    uint32_t format_generation, uint32_t scale_groups) {
    AscendC::GlobalTensor<uint8_t> values, fmt;
    AscendC::GlobalTensor<int32_t> blocks, lengths, byte_offsets;
    AscendC::GlobalTensor<float> per_head_scales, probs, out;
    probs.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(probabilities));
    values.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(value_cache));
    blocks.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(block_tables));
    lengths.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(context_lens));
    fmt.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(formats));
    byte_offsets.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(offsets));
    per_head_scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scales));
    out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output));
    const uint32_t sequence_stride = max_blocks * block_size;
    for (uint32_t row = AscendC::GetBlockIdx();
         row < num_seqs * heads; row += AscendC::GetBlockNum()) {
        const uint32_t seq = row / heads;
        const uint32_t head = row % heads;
        const uint32_t kv_head = head / (heads / kv_heads);
        const uint32_t length = static_cast<uint32_t>(lengths.GetValue(seq));
        for (uint32_t dim = 0; dim < head_dim; ++dim) {
            float accumulator = 0.0f;
            for (uint32_t position = 0; position < length; ++position) {
                const uint32_t physical = static_cast<uint32_t>(blocks.GetValue(
                    seq * max_blocks + position / block_size));
                const uint8_t format = fmt.GetValue(physical);
                const uint32_t per_head = PackedBytesPerHead(
                    format, block_size, head_dim, target_dtype);
                const uint32_t base = static_cast<uint32_t>(byte_offsets.GetValue(physical))
                                    + kv_head * per_head;
                const float scale = format_generation == 0 || format == 0
                    ? 1.0f : per_head_scales.GetValue(PackedScaleIndex(
                        physical, 1, kv_head, dim, kv_heads, head_dim,
                        scale_groups));
                const uint32_t element = format_generation == 0
                                      || format_generation == 3
                    ? (position % block_size) * head_dim + dim
                    : dim * block_size + position % block_size;
                const float v_value = ReadPacked(values, base, element,
                    format, target_dtype, scale);
                accumulator += probs.GetValue(row * sequence_stride + position) * v_value;
            }
            out.SetValue(row * head_dim + dim, accumulator);
        }
    }
}

// Single-token scaled-basic attention over compressed, token-major K/V.
// Scores and softmax probabilities stay in UB; only the final FP32 output
// reaches GM. This is a correctness-first fusion: K/V reads and QK/V math
// are still scalar, and the long-context tiled implementation comes next.
__global__ __vector__ void PspkvPackedFusedDecode(
    GM_ADDR query, GM_ADDR key_cache, GM_ADDR value_cache,
    GM_ADDR block_tables, GM_ADDR context_lens, GM_ADDR formats,
    GM_ADDR offsets, GM_ADDR scales, GM_ADDR output,
    uint32_t num_seqs, uint32_t heads, uint32_t kv_heads,
    uint32_t head_dim, uint32_t block_size, uint32_t max_blocks,
    uint32_t target_dtype, uint32_t scale_groups, float softmax_scale) {
    AscendC::GlobalTensor<uint8_t> q, keys, values, fmt;
    AscendC::GlobalTensor<int32_t> blocks, lengths, byte_offsets;
    AscendC::GlobalTensor<float> per_head_scales, out;
    q.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(query));
    keys.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(key_cache));
    values.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(value_cache));
    blocks.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(block_tables));
    lengths.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(context_lens));
    fmt.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(formats));
    byte_offsets.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(offsets));
    per_head_scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scales));
    out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output));

    const uint32_t sequence_stride = max_blocks * block_size;
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECCALC, 1> scoreQueue,
        shiftQueue, expQueue;
    pipe.InitBuffer(scoreQueue, 1, sequence_stride * sizeof(float));
    pipe.InitBuffer(shiftQueue, 1, sequence_stride * sizeof(float));
    pipe.InitBuffer(expQueue, 1, sequence_stride * sizeof(float));
    AscendC::LocalTensor<float> scoreLocal = scoreQueue.AllocTensor<float>();
    AscendC::LocalTensor<float> shiftLocal = shiftQueue.AllocTensor<float>();
    AscendC::LocalTensor<float> expLocal = expQueue.AllocTensor<float>();

    for (uint32_t row = AscendC::GetBlockIdx();
         row < num_seqs * heads; row += AscendC::GetBlockNum()) {
        const uint32_t seq = row / heads;
        const uint32_t head = row % heads;
        const uint32_t kv_head = head / (heads / kv_heads);
        const uint32_t length = static_cast<uint32_t>(lengths.GetValue(seq));
        float max_score = -3.402823466e38f;
        for (uint32_t position = 0; position < length; ++position) {
            const uint32_t physical = static_cast<uint32_t>(blocks.GetValue(
                seq * max_blocks + position / block_size));
            const uint8_t format = fmt.GetValue(physical);
            const uint32_t per_head = PackedBytesPerHead(
                format, block_size, head_dim, target_dtype);
            const uint32_t base = static_cast<uint32_t>(
                byte_offsets.GetValue(physical)) + kv_head * per_head;
            float dot = 0.0f;
            for (uint32_t dim = 0; dim < head_dim; ++dim) {
                const float scale = format == 0 ? 1.0f
                    : per_head_scales.GetValue(PackedScaleIndex(
                        physical, 0, kv_head, dim, kv_heads, head_dim,
                        scale_groups));
                const float q_value = ReadTarget(
                    q, row * head_dim + dim, target_dtype);
                const float k_value = ReadPacked(
                    keys, base, (position % block_size) * head_dim + dim,
                    format, target_dtype, scale);
                dot += q_value * k_value;
            }
            const float score = dot * softmax_scale;
            scoreLocal.SetValue(position, score);
            if (score > max_score) max_score = score;
        }
        for (uint32_t position = length; position < sequence_stride;
             ++position) {
            scoreLocal.SetValue(position, -3.402823466e38f);
        }
        pipe_barrier(PIPE_ALL);
        AscendC::Adds(shiftLocal, scoreLocal, -max_score, sequence_stride);
        pipe_barrier(PIPE_ALL);
        AscendC::Exp(expLocal, shiftLocal, sequence_stride);
        pipe_barrier(PIPE_ALL);
        float denominator = 0.0f;
        for (uint32_t position = 0; position < length; ++position) {
            denominator += expLocal.GetValue(position);
        }
        const float inverse_denominator = 1.0f / denominator;
        for (uint32_t dim = 0; dim < head_dim; ++dim) {
            float accumulator = 0.0f;
            for (uint32_t position = 0; position < length; ++position) {
                const uint32_t physical = static_cast<uint32_t>(blocks.GetValue(
                    seq * max_blocks + position / block_size));
                const uint8_t format = fmt.GetValue(physical);
                const uint32_t per_head = PackedBytesPerHead(
                    format, block_size, head_dim, target_dtype);
                const uint32_t base = static_cast<uint32_t>(
                    byte_offsets.GetValue(physical)) + kv_head * per_head;
                const float scale = format == 0 ? 1.0f
                    : per_head_scales.GetValue(PackedScaleIndex(
                        physical, 1, kv_head, dim, kv_heads, head_dim,
                        scale_groups));
                const float v_value = ReadPacked(
                    values, base, (position % block_size) * head_dim + dim,
                    format, target_dtype, scale);
                accumulator += expLocal.GetValue(position) *
                               inverse_denominator * v_value;
            }
            out.SetValue(row * head_dim + dim, accumulator);
        }
    }
}

// torch_npu does not support every FP32 -> FP8 copy route on 910B3. Write
// output FP8 bytes directly for the CUDA test contract's FP8 target dtypes.
__global__ __vector__ void PspkvCastFP8Output(
    GM_ADDR source, GM_ADDR output, uint32_t count, uint32_t format) {
    AscendC::GlobalTensor<float> input;
    AscendC::GlobalTensor<uint8_t> out;
    input.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(source), count);
    out.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(output), count);
    constexpr uint32_t ELEMENTS_PER_CHUNK = 256;
    for (uint32_t chunk = AscendC::GetBlockIdx();
         chunk * ELEMENTS_PER_CHUNK < count;
         chunk += AscendC::GetBlockNum()) {
        const uint32_t start = chunk * ELEMENTS_PER_CHUNK;
        const uint32_t end = start + ELEMENTS_PER_CHUNK < count
                           ? start + ELEMENTS_PER_CHUNK : count;
        for (uint32_t index = start; index < end; ++index) {
            union { float f; uint32_t u; } converted;
            converted.f = input.GetValue(index);
            out.SetValue(index, format == 2 ? EncodeE5M2(converted.u)
                                            : EncodeE4M3(converted.u));
        }
    }
}

// Transposed FP4 V can place two tokens in one output byte, so that layout
// uses one AI Core. The live token-major FP4 layout has an even head dimension:
// each token/head owns whole bytes and can be scattered by a separate core
// when rows are also 64-byte aligned for the device cache.
__global__ __vector__ void PspkvPackedScatter(
    GM_ADDR prefill, GM_ADDR key_cache, GM_ADDR value_cache,
    GM_ADDR slot_mapping, GM_ADDR formats, GM_ADDR offsets,
    GM_ADDR scales, uint32_t num_tokens, uint32_t kv_heads,
    uint32_t head_dim, uint32_t block_size, uint32_t target_dtype,
    uint32_t format_generation, uint32_t preserve_scales,
    uint32_t scale_groups) {
    AscendC::GlobalTensor<uint8_t> source, keys, values, fmt;
    AscendC::GlobalTensor<int64_t> slots;
    AscendC::GlobalTensor<int32_t> byte_offsets;
    AscendC::GlobalTensor<float> per_head_scales;
    source.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(prefill));
    keys.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(key_cache));
    values.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(value_cache));
    slots.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(slot_mapping));
    fmt.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(formats));
    byte_offsets.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(offsets));
    per_head_scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scales));
    for (uint32_t token = AscendC::GetBlockIdx();
         token < num_tokens; token += AscendC::GetBlockNum()) {
        const int64_t slot = slots.GetValue(token);
        if (slot < 0) continue;
        const uint32_t physical = static_cast<uint32_t>(slot / block_size);
        const uint32_t within_block = static_cast<uint32_t>(slot % block_size);
        const uint8_t format = fmt.GetValue(physical);
        const uint32_t bytes_per_head = PackedBytesPerHead(
            format, block_size, head_dim, target_dtype);
        for (uint32_t head = 0; head < kv_heads; ++head) {
            const uint32_t base = static_cast<uint32_t>(byte_offsets.GetValue(physical))
                                + head * bytes_per_head;
            for (uint32_t dim = 0; dim < head_dim; ++dim) {
                const uint32_t key_scale_index = PackedScaleIndex(
                    physical, 0, head, dim, kv_heads, head_dim, scale_groups);
                const uint32_t value_scale_index = PackedScaleIndex(
                    physical, 1, head, dim, kv_heads, head_dim, scale_groups);
                const float key_scale = preserve_scales && format == 3
                    ? per_head_scales.GetValue(key_scale_index) : 1.0f;
                const float value_scale = preserve_scales && format == 3
                    ? per_head_scales.GetValue(value_scale_index) : 1.0f;
                if (!preserve_scales) {
                    per_head_scales.SetValue(key_scale_index, 1.0f);
                    if (scale_groups > 0)
                        per_head_scales.SetValue(value_scale_index, 1.0f);
                }
                const uint32_t source_key = ((token * 2) * kv_heads + head)
                                          * head_dim + dim;
                const uint32_t source_value = ((token * 2 + 1) * kv_heads + head)
                                            * head_dim + dim;
                const uint32_t key_element = within_block * head_dim + dim;
                const uint32_t value_element = format_generation == 0
                    || format_generation == 3
                    ? key_element : dim * block_size + within_block;
                WritePacked(source, keys, source_key, base, key_element,
                            format, target_dtype, key_scale);
                WritePacked(source, values, source_value, base, value_element,
                            format, target_dtype, value_scale);
            }
        }
    }
}

// Each job owns complete cache lines. Token/head K rows and Basic V rows
// contain >=64 bytes even for FP4; transposed V jobs own a whole dimension
// row (>=64 bytes). Slots must be unique within a call. Unit scales are
// initialized by the caller instead of rewritten once per element.
#include "pspkv_rope.h"

template <bool SeparateKV = false>
__global__ __vector__ void PspkvPackedScatterParallel(
    GM_ADDR prefill, GM_ADDR value_source, GM_ADDR key_cache, GM_ADDR value_cache, GM_ADDR slot_mapping,
    GM_ADDR formats, GM_ADDR offsets, GM_ADDR scales, uint32_t tokens,
    uint32_t heads, uint32_t dimension, uint32_t block_size, uint32_t generation,
    uint32_t key_token_stride, uint32_t key_head_stride,
    uint32_t value_token_stride, uint32_t value_head_stride) {
    AscendC::GlobalTensor<uint8_t> source, value_input, keys, values, codes;
    AscendC::GlobalTensor<int64_t> slots;
    AscendC::GlobalTensor<int32_t> byte_offsets;
    AscendC::GlobalTensor<float> per_head_scales;
    source.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(prefill));
    value_input.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(value_source));
    keys.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(key_cache));
    values.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(value_cache));
    codes.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(formats));
    slots.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(slot_mapping));
    byte_offsets.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(offsets));
    per_head_scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scales));
    const uint32_t key_jobs = tokens * heads;
    const uint32_t value_jobs = generation == 0 ? key_jobs : heads * dimension;
    for (uint32_t job = AscendC::GetBlockIdx(); job < key_jobs + value_jobs;
         job += AscendC::GetBlockNum()) {
        const bool key_job = job < key_jobs;
        const uint32_t local = key_job ? job : job - key_jobs;
        const bool token_major = key_job || generation == 0;
        const uint32_t head = token_major ? local % heads : local / dimension;
        const uint32_t count = token_major ? dimension : tokens;
        for (uint32_t i = 0; i < count; ++i) {
            const uint32_t token = token_major ? local / heads : i;
            const uint32_t dim = token_major ? i : local % dimension;
            const int64_t slot = slots.GetValue(token);
            if (slot < 0) continue;
            const uint32_t physical = static_cast<uint32_t>(slot / block_size);
            const uint32_t within = static_cast<uint32_t>(slot % block_size);
            const uint8_t code = codes.GetValue(physical);
            const uint32_t per_head = PackedBytesPerHead(code, block_size, dimension, 0);
            const uint32_t base = static_cast<uint32_t>(byte_offsets.GetValue(physical))
                                  + head * per_head;
            const uint32_t element = token_major ? within * dimension + dim
                                                : dim * block_size + within;
            const uint32_t src = SeparateKV
                ? token * (key_job ? key_token_stride : value_token_stride)
                  + head * (key_job ? key_head_stride : value_head_stride) + dim
                : ((token * 2 + (key_job ? 0 : 1)) * heads + head) * dimension + dim;
            const float scale = code == 3
                ? per_head_scales.GetValue(physical * heads + head) : 1.0f;
            if (key_job) WritePacked(source, keys, src, base, element, code, 0, scale);
            else if (SeparateKV) WritePacked(value_input, values, src, base, element, code, 0, scale);
            else WritePacked(source, values, src, base, element, code, 0, scale);
        }
    }
}

// Gather only pages named by the live block table, never the entire arena.
// Output is the native paged-attention layout [pages, block, KV head, dim].
// Whole head rows are owned by one worker and copied via UB. Metadata and
// layout arithmetic are hoisted out of the element loop; tail rows use SIMD.
__global__ __vector__ void PspkvGatherPagedBF16(
    GM_ADDR key_cache, GM_ADDR value_cache, GM_ADDR block_tables,
    GM_ADDR context_lens, GM_ADDR formats, GM_ADDR offsets, GM_ADDR scales,
    GM_ADDR key_output, GM_ADDR value_output, uint32_t seqs, uint32_t max_blocks,
    uint32_t heads, uint32_t dimension, uint32_t block_size, uint32_t generation) {
    AscendC::GlobalTensor<uint8_t> keys, values, codes;
    AscendC::GlobalTensor<int32_t> tables, lengths, byte_offsets;
    AscendC::GlobalTensor<float> per_head_scales;
    AscendC::GlobalTensor<uint16_t> key_out, value_out;
    keys.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(key_cache));
    values.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(value_cache));
    codes.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(formats));
    tables.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(block_tables));
    lengths.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(context_lens));
    byte_offsets.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(offsets));
    per_head_scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scales));
    key_out.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(key_output));
    value_out.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(value_output));
    constexpr uint32_t MAX_DIM = 256;
    const uint32_t rows = seqs * max_blocks * block_size * heads;
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, MAX_DIM * sizeof(uint16_t));
    auto local = buffer.Get<uint16_t>();
    for (uint32_t task = AscendC::GetBlockIdx(); task < 2 * rows;
         task += AscendC::GetBlockNum()) {
        const bool is_key = task < rows;
        const uint32_t row = task % rows;
        const uint32_t start = row * dimension;
        const uint32_t head = row % heads;
        uint32_t index = row / heads;
        const uint32_t token = index % block_size; index /= block_size;
        const uint32_t logical_block = index % max_blocks;
        const uint32_t seq = index / max_blocks;
        if (logical_block * block_size + token >= static_cast<uint32_t>(lengths.GetValue(seq))) {
            AscendC::Duplicate(local, static_cast<uint16_t>(0), dimension);
        } else {
            const uint32_t physical = static_cast<uint32_t>(tables.GetValue(index));
            const uint8_t code = codes.GetValue(physical);
            const uint32_t per_head = PackedBytesPerHead(code, block_size, dimension, 0);
            const uint32_t base = static_cast<uint32_t>(byte_offsets.GetValue(physical)) + head * per_head;
            const float scale = code == 0 || generation == 0 ? 1.0f
                : per_head_scales.GetValue(physical * heads + head);
            for (uint32_t dim = 0; dim < dimension; ++dim) {
                const uint32_t element = is_key || generation == 0
                    ? token * dimension + dim : dim * block_size + token;
                const float decoded = is_key
                    ? ReadPacked(keys, base, element, code, 0, scale)
                    : ReadPacked(values, base, element, code, 0, scale);
                union { float f; uint32_t u; } bits;
                bits.f = decoded;
                // Match torch's FP32->BF16 round-to-nearest-even.
                const uint32_t rounded = bits.u + 0x7fffU + ((bits.u >> 16) & 1U);
                local.SetValue(dim, static_cast<uint16_t>(
                    (bits.u & 0x7fffffffU) > 0x7f800000U
                        ? (bits.u >> 16) | 0x40U : rounded >> 16));
            }
        }
        pipe_barrier(PIPE_ALL);
        if (is_key) AscendC::DataCopy(key_out[start], local, dimension);
        else AscendC::DataCopy(value_out[start], local, dimension);
        pipe_barrier(PIPE_ALL);
    }
}

__global__ __vector__ void PspkvPackedDequant(
    GM_ADDR key_cache, GM_ADDR value_cache, GM_ADDR offsets,
    GM_ADDR formats, GM_ADDR scales, GM_ADDR key_output,
    GM_ADDR value_output, uint32_t total, uint32_t kv_heads,
    uint32_t block_size, uint32_t head_dim, uint32_t target_dtype,
    uint32_t format_generation, uint32_t scale_groups) {
    AscendC::GlobalTensor<uint8_t> keys, values, fmt;
    AscendC::GlobalTensor<int32_t> byte_offsets;
    AscendC::GlobalTensor<float> per_head_scales, k_out, v_out;
    keys.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(key_cache));
    values.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(value_cache));
    byte_offsets.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(offsets));
    fmt.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(formats));
    per_head_scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scales));
    k_out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(key_output), total);
    v_out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(value_output), total);
    constexpr uint32_t ELEMENTS_PER_CHUNK = 256;
    const uint32_t elements_per_block = kv_heads * block_size * head_dim;
    for (uint32_t chunk = AscendC::GetBlockIdx();
         chunk * ELEMENTS_PER_CHUNK < total;
         chunk += AscendC::GetBlockNum()) {
        const uint32_t start = chunk * ELEMENTS_PER_CHUNK;
        const uint32_t end = start + ELEMENTS_PER_CHUNK < total
                           ? start + ELEMENTS_PER_CHUNK : total;
        for (uint32_t index = start; index < end; ++index) {
            const uint32_t physical = index / elements_per_block;
            const uint32_t within_block = index % elements_per_block;
            const uint32_t head = within_block / (block_size * head_dim);
            const uint32_t token = (within_block / head_dim) % block_size;
            const uint32_t dim = within_block % head_dim;
            const uint8_t format = fmt.GetValue(physical);
            const uint32_t base = static_cast<uint32_t>(byte_offsets.GetValue(physical))
                + head * PackedBytesPerHead(format, block_size, head_dim,
                                            target_dtype);
            const float key_scale = format == 0 ? 1.0f
                : per_head_scales.GetValue(PackedScaleIndex(
                    physical, 0, head, dim, kv_heads, head_dim, scale_groups));
            const float value_scale = format == 0 ? 1.0f
                : per_head_scales.GetValue(PackedScaleIndex(
                    physical, 1, head, dim, kv_heads, head_dim, scale_groups));
            const uint32_t key_element = token * head_dim + dim;
            const uint32_t value_element = format_generation == 0
                                          || format_generation == 3
                ? key_element : dim * block_size + token;
            k_out.SetValue(index, ReadPacked(keys, base, key_element,
                                             format, target_dtype, key_scale));
            v_out.SetValue(index, ReadPacked(values, base, value_element,
                                             format, target_dtype, value_scale));
        }
    }
}

// Dense staging consumer for the CUDA basic-format pipeline. The cache is
// [physical block, KV head, token, dimension] at the query's target dtype.
__global__ __vector__ void PspkvUniformScores(
    GM_ADDR query, GM_ADDR key_cache, GM_ADDR block_tables,
    GM_ADDR context_lens, GM_ADDR scores, uint32_t num_seqs,
    uint32_t heads, uint32_t kv_heads, uint32_t head_dim,
    uint32_t block_size, uint32_t max_blocks, uint32_t target_dtype,
    float softmax_scale) {
    AscendC::GlobalTensor<uint8_t> q, keys;
    AscendC::GlobalTensor<int32_t> blocks, lengths;
    AscendC::GlobalTensor<float> out;
    q.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(query));
    keys.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(key_cache));
    blocks.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(block_tables));
    lengths.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(context_lens));
    out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scores));
    const uint32_t sequence_stride = max_blocks * block_size;
    for (uint32_t row = AscendC::GetBlockIdx();
         row < num_seqs * heads; row += AscendC::GetBlockNum()) {
        const uint32_t seq = row / heads;
        const uint32_t kv_head = row % heads / (heads / kv_heads);
        const uint32_t length = static_cast<uint32_t>(lengths.GetValue(seq));
        for (uint32_t position = 0; position < sequence_stride; ++position) {
            if (position >= length) {
                out.SetValue(row * sequence_stride + position, -3.402823466e38f);
                continue;
            }
            const uint32_t physical = static_cast<uint32_t>(blocks.GetValue(
                seq * max_blocks + position / block_size));
            const uint32_t key_base = ((physical * kv_heads + kv_head)
                                      * block_size + position % block_size) * head_dim;
            float dot = 0.0f;
            for (uint32_t dim = 0; dim < head_dim; ++dim) {
                dot += ReadTarget(q, row * head_dim + dim, target_dtype)
                     * ReadTarget(keys, key_base + dim, target_dtype);
            }
            out.SetValue(row * sequence_stride + position, dot * softmax_scale);
        }
    }
}

__global__ __vector__ void PspkvUniformWeightedValue(
    GM_ADDR probabilities, GM_ADDR value_cache, GM_ADDR block_tables,
    GM_ADDR context_lens, GM_ADDR output, uint32_t num_seqs,
    uint32_t heads, uint32_t kv_heads, uint32_t head_dim,
    uint32_t block_size, uint32_t max_blocks, uint32_t target_dtype) {
    AscendC::GlobalTensor<uint8_t> values;
    AscendC::GlobalTensor<int32_t> blocks, lengths;
    AscendC::GlobalTensor<float> probs, out;
    probs.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(probabilities));
    values.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(value_cache));
    blocks.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(block_tables));
    lengths.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(context_lens));
    out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output));
    const uint32_t sequence_stride = max_blocks * block_size;
    for (uint32_t row = AscendC::GetBlockIdx();
         row < num_seqs * heads; row += AscendC::GetBlockNum()) {
        const uint32_t seq = row / heads;
        const uint32_t kv_head = row % heads / (heads / kv_heads);
        const uint32_t length = static_cast<uint32_t>(lengths.GetValue(seq));
        for (uint32_t dim = 0; dim < head_dim; ++dim) {
            float accumulator = 0.0f;
            for (uint32_t position = 0; position < length; ++position) {
                const uint32_t physical = static_cast<uint32_t>(blocks.GetValue(
                    seq * max_blocks + position / block_size));
                const uint32_t value_element = ((physical * kv_heads + kv_head)
                    * block_size + position % block_size) * head_dim + dim;
                accumulator += probs.GetValue(row * sequence_stride + position)
                    * ReadTarget(values, value_element, target_dtype);
            }
            out.SetValue(row * head_dim + dim, accumulator);
        }
    }
}

// ---------------------------------------------------------------------------
// Row-batched, UB-staged variants of the packed decode kernels. They issue
// DataCopy batches instead of one global load per element and decode bytes
// through lookup tables generated by the Python reference codec, so every
// arithmetic step stays in the same order as the scalar kernels and the
// results remain bit-identical. Formats 1/2/3 (E4M3/E5M2/FP4) use the staged
// path; the lossless format 0 falls back to scalar global reads.
// ---------------------------------------------------------------------------
constexpr uint32_t PSPKV_ROWS_PER_CHUNK = 8;

__global__ __vector__ void PspkvPackedScoresVec(
    GM_ADDR query, GM_ADDR key_cache, GM_ADDR block_tables,
    GM_ADDR context_lens, GM_ADDR formats, GM_ADDR offsets,
    GM_ADDR scales, GM_ADDR e4m3_table, GM_ADDR e5m2_table, GM_ADDR fp4_table,
    GM_ADDR scores, uint32_t num_seqs, uint32_t heads,
    uint32_t kv_heads, uint32_t head_dim, uint32_t block_size,
    uint32_t max_blocks, uint32_t target_dtype,
    uint32_t format_generation, uint32_t scale_groups,
    float softmax_scale, uint32_t cache_bytes) {
    AscendC::GlobalTensor<uint16_t> q;
    AscendC::GlobalTensor<uint8_t> keys, fmt;
    AscendC::GlobalTensor<int32_t> blocks, lengths, byte_offsets;
    AscendC::GlobalTensor<float> per_head_scales, out, e4, e5, f4;
    q.SetGlobalBuffer(
        reinterpret_cast<__gm__ uint16_t*>(query), num_seqs * heads * head_dim);
    keys.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(key_cache),
                         cache_bytes);
    blocks.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(block_tables));
    lengths.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(context_lens));
    fmt.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(formats));
    byte_offsets.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(offsets));
    per_head_scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scales));
    out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scores));
    e4.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(e4m3_table), 256);
    e5.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(e5m2_table), 256);
    f4.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(fp4_table), 16);

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> qQueue, kQueue,
        e4Queue, e5Queue, f4Queue;
    pipe.InitBuffer(qQueue, 1, head_dim * 2);
    pipe.InitBuffer(kQueue, 1, PSPKV_ROWS_PER_CHUNK * head_dim);
    pipe.InitBuffer(e4Queue, 1, 256 * 4);
    pipe.InitBuffer(e5Queue, 1, 256 * 4);
    pipe.InitBuffer(f4Queue, 1, 256 * 4);
    AscendC::LocalTensor<uint16_t> qLocal = qQueue.AllocTensor<uint16_t>();
    AscendC::LocalTensor<uint8_t> kLocal = kQueue.AllocTensor<uint8_t>();
    AscendC::LocalTensor<float> e4Local = e4Queue.AllocTensor<float>();
    AscendC::LocalTensor<float> e5Local = e5Queue.AllocTensor<float>();
    AscendC::LocalTensor<float> f4Local = f4Queue.AllocTensor<float>();
    AscendC::DataCopy(e4Local, e4[0], 256);
    AscendC::DataCopy(e5Local, e5[0], 256);
    AscendC::DataCopy(f4Local, f4[0], 256);
    pipe_barrier(PIPE_ALL);

    const uint32_t group_size = heads / kv_heads;
    const uint32_t sequence_stride = max_blocks * block_size;
    for (uint32_t row = AscendC::GetBlockIdx();
         row < num_seqs * heads; row += AscendC::GetBlockNum()) {
        const uint32_t seq = row / heads;
        const uint32_t head = row % heads;
        const uint32_t kv_head = head / group_size;
        const uint32_t length = static_cast<uint32_t>(lengths.GetValue(seq));
        AscendC::DataCopy(qLocal, q[row * head_dim], head_dim);
        pipe_barrier(PIPE_ALL);
        const uint32_t blocks_used = (length + block_size - 1) / block_size;
        for (uint32_t block_index = 0; block_index < blocks_used; ++block_index) {
            const uint32_t physical = static_cast<uint32_t>(
                blocks.GetValue(seq * max_blocks + block_index));
            const uint8_t format = fmt.GetValue(physical);
            const uint32_t per_head = PackedBytesPerHead(
                format, block_size, head_dim, target_dtype);
            const uint32_t base = static_cast<uint32_t>(
                byte_offsets.GetValue(physical)) + kv_head * per_head;
            const uint32_t rows_in_block = block_index * block_size + block_size <= length
                ? block_size : length - block_index * block_size;
            if (format == 0) {
                for (uint32_t position = 0; position < rows_in_block; ++position) {
                    float dot = 0.0f;
                    for (uint32_t dim = 0; dim < head_dim; ++dim) {
                        const float q_value = target_dtype == 1
                            ? DecodeHalf(q.GetValue(row * head_dim + dim))
                            : [] (uint16_t raw) {
                                union { uint32_t u; float f; } cv;
                                cv.u = static_cast<uint32_t>(raw) << 16;
                                return cv.f;
                            }(q.GetValue(row * head_dim + dim));
                        dot += q_value * ReadPacked(keys, base,
                            position * head_dim + dim, format, target_dtype, 1.0f);
                    }
                    out.SetValue(row * sequence_stride
                        + block_index * block_size + position,
                        dot * softmax_scale);
                }
                continue;
            }
            const uint32_t row_bytes = format == 3 ? head_dim / 2 : head_dim;
            for (uint32_t chunk_start = 0; chunk_start < rows_in_block;
                 chunk_start += PSPKV_ROWS_PER_CHUNK) {
                const uint32_t rows = rows_in_block - chunk_start < PSPKV_ROWS_PER_CHUNK
                    ? rows_in_block - chunk_start : PSPKV_ROWS_PER_CHUNK;
                AscendC::DataCopy(kLocal,
                                  keys[base + chunk_start * row_bytes],
                                  rows * row_bytes);
                pipe_barrier(PIPE_ALL);
                for (uint32_t p = 0; p < rows; ++p) {
                    const uint32_t position = block_index * block_size
                                            + chunk_start + p;
                    float dot = 0.0f;
                    for (uint32_t dim = 0; dim < head_dim; ++dim) {
                        float q_value;
                        const uint16_t qv = qLocal.GetValue(dim);
                        if (target_dtype == 1) {
                            q_value = DecodeHalf(qv);
                        } else {
                            union { uint32_t u; float f; } cv;
                            cv.u = static_cast<uint32_t>(qv) << 16;
                            q_value = cv.f;
                        }
                        float k_value;
                        if (format == 3) {
                            const uint8_t packed = kLocal.GetValue(
                                p * row_bytes + dim / 2);
                            const uint8_t nibble = dim & 1
                                ? packed >> 4 : packed & 15;
                            const float scale = per_head_scales.GetValue(
                                PackedScaleIndex(physical, 0, kv_head, dim,
                                                 kv_heads, head_dim,
                                                 scale_groups));
                            k_value = f4Local.GetValue(nibble) * scale;
                        } else {
                            const uint8_t byte = kLocal.GetValue(p * row_bytes + dim);
                            k_value = (format == 2 ? e5Local : e4Local).GetValue(byte);
                        }
                        dot += q_value * k_value;
                    }
                    out.SetValue(row * sequence_stride + position,
                                 dot * softmax_scale);
                }
                pipe_barrier(PIPE_ALL);
            }
        }
        for (uint32_t position = length; position < sequence_stride; ++position) {
            out.SetValue(row * sequence_stride + position, -3.402823466e38f);
        }
    }
}

__global__ __vector__ void PspkvPackedWeightedValueVec(
    GM_ADDR probabilities, GM_ADDR value_cache, GM_ADDR block_tables,
    GM_ADDR context_lens, GM_ADDR formats, GM_ADDR offsets,
    GM_ADDR scales, GM_ADDR e4m3_table, GM_ADDR e5m2_table, GM_ADDR fp4_table,
    GM_ADDR output, uint32_t num_seqs, uint32_t heads,
    uint32_t kv_heads, uint32_t head_dim, uint32_t block_size,
    uint32_t max_blocks, uint32_t target_dtype,
    uint32_t format_generation, uint32_t scale_groups,
    uint32_t cache_bytes) {
    AscendC::GlobalTensor<float> probs, out, per_head_scales, e4, e5, f4;
    AscendC::GlobalTensor<uint8_t> values, fmt;
    AscendC::GlobalTensor<int32_t> blocks, lengths, byte_offsets;
    probs.SetGlobalBuffer(
        reinterpret_cast<__gm__ float*>(probabilities),
        num_seqs * heads * max_blocks * block_size);
    values.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(value_cache),
                           cache_bytes);
    blocks.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(block_tables));
    lengths.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(context_lens));
    fmt.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(formats));
    byte_offsets.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(offsets));
    per_head_scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scales));
    out.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output));
    e4.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(e4m3_table), 256);
    e5.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(e5m2_table), 256);
    f4.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(fp4_table), 16);

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> vQueue, pQueue,
        accQueue, e4Queue, e5Queue, f4Queue;
    pipe.InitBuffer(vQueue, 1, PSPKV_ROWS_PER_CHUNK * head_dim);
    pipe.InitBuffer(pQueue, 1, max_blocks * block_size * 4);
    pipe.InitBuffer(accQueue, 1, head_dim * 4);
    pipe.InitBuffer(e4Queue, 1, 256 * 4);
    pipe.InitBuffer(e5Queue, 1, 256 * 4);
    pipe.InitBuffer(f4Queue, 1, 256 * 4);
    AscendC::LocalTensor<uint8_t> vLocal = vQueue.AllocTensor<uint8_t>();
    AscendC::LocalTensor<float> pLocal = pQueue.AllocTensor<float>();
    AscendC::LocalTensor<float> accLocal = accQueue.AllocTensor<float>();
    AscendC::LocalTensor<float> e4Local = e4Queue.AllocTensor<float>();
    AscendC::LocalTensor<float> e5Local = e5Queue.AllocTensor<float>();
    AscendC::LocalTensor<float> f4Local = f4Queue.AllocTensor<float>();
    AscendC::DataCopy(e4Local, e4[0], 256);
    AscendC::DataCopy(e5Local, e5[0], 256);
    AscendC::DataCopy(f4Local, f4[0], 256);
    pipe_barrier(PIPE_ALL);

    const uint32_t group_size = heads / kv_heads;
    const uint32_t sequence_stride = max_blocks * block_size;
    for (uint32_t row = AscendC::GetBlockIdx();
         row < num_seqs * heads; row += AscendC::GetBlockNum()) {
        const uint32_t seq = row / heads;
        const uint32_t head = row % heads;
        const uint32_t kv_head = head / group_size;
        const uint32_t length = static_cast<uint32_t>(lengths.GetValue(seq));
        // DataCopy transfers whole 32-byte units; round the probability row
        // up so the last token's probability is not dropped.
        const uint32_t aligned_length = ((length + 7) / 8) * 8;
        AscendC::DataCopy(pLocal, probs[row * sequence_stride],
                          aligned_length < sequence_stride
                              ? aligned_length : sequence_stride);
        for (uint32_t dim = 0; dim < head_dim; ++dim) {
            accLocal.SetValue(dim, 0.0f);
        }
        pipe_barrier(PIPE_ALL);
        const uint32_t blocks_used = (length + block_size - 1) / block_size;
        for (uint32_t block_index = 0; block_index < blocks_used; ++block_index) {
            const uint32_t physical = static_cast<uint32_t>(
                blocks.GetValue(seq * max_blocks + block_index));
            const uint8_t format = fmt.GetValue(physical);
            const uint32_t per_head = PackedBytesPerHead(
                format, block_size, head_dim, target_dtype);
            const uint32_t base = static_cast<uint32_t>(
                byte_offsets.GetValue(physical)) + kv_head * per_head;
            const uint32_t rows_in_block = block_index * block_size + block_size <= length
                ? block_size : length - block_index * block_size;
            if (format == 0) {
                for (uint32_t position = 0; position < rows_in_block; ++position) {
                    const float prob = pLocal.GetValue(
                        block_index * block_size + position);
                    for (uint32_t dim = 0; dim < head_dim; ++dim) {
                        const float v_value = ReadPacked(values, base,
                            position * head_dim + dim, format, target_dtype, 1.0f);
                        accLocal.SetValue(dim, accLocal.GetValue(dim)
                            + prob * v_value);
                    }
                }
                continue;
            }
            const uint32_t row_bytes = format == 3 ? head_dim / 2 : head_dim;
            for (uint32_t chunk_start = 0; chunk_start < rows_in_block;
                 chunk_start += PSPKV_ROWS_PER_CHUNK) {
                const uint32_t rows = rows_in_block - chunk_start < PSPKV_ROWS_PER_CHUNK
                    ? rows_in_block - chunk_start : PSPKV_ROWS_PER_CHUNK;
                AscendC::DataCopy(vLocal,
                                  values[base + chunk_start * row_bytes],
                                  rows * row_bytes);
                pipe_barrier(PIPE_ALL);
                for (uint32_t p = 0; p < rows; ++p) {
                    const float prob = pLocal.GetValue(
                        block_index * block_size + chunk_start + p);
                    for (uint32_t dim = 0; dim < head_dim; ++dim) {
                        float v_value;
                        if (format == 3) {
                            const uint8_t packed = vLocal.GetValue(
                                p * row_bytes + dim / 2);
                            const uint8_t nibble = dim & 1
                                ? packed >> 4 : packed & 15;
                            const float scale = per_head_scales.GetValue(
                                PackedScaleIndex(physical, 1, kv_head, dim,
                                                 kv_heads, head_dim,
                                                 scale_groups));
                            v_value = f4Local.GetValue(nibble) * scale;
                        } else {
                            const uint8_t byte = vLocal.GetValue(p * row_bytes + dim);
                            v_value = (format == 2 ? e5Local : e4Local).GetValue(byte);
                        }
                        accLocal.SetValue(dim, accLocal.GetValue(dim)
                            + prob * v_value);
                    }
                }
                pipe_barrier(PIPE_ALL);
            }
        }
        for (uint32_t dim = 0; dim < head_dim; ++dim) {
            out.SetValue(row * head_dim + dim, accLocal.GetValue(dim));
        }
    }
}

namespace psp_kv_ascend_native {
void quantize_scatter_bf16(const at::Tensor& key, const at::Tensor& value,
                           const at::Tensor& slots, const at::Tensor& formats,
                           at::Tensor& key_cache, at::Tensor& value_cache) {
    TORCH_CHECK(key.device().type() == c10::DeviceType::PrivateUse1,
                "PSP-KV native quantizer needs NPU tensors");
    TORCH_CHECK(key.scalar_type() == at::kBFloat16 && value.scalar_type() == at::kBFloat16,
                "PSP-KV native quantizer supports BF16 K/V only");
    TORCH_CHECK(key.dim() == 3 && key.sizes() == value.sizes() && key.is_contiguous()
                && value.is_contiguous(), "K/V must be contiguous [tokens, heads, dim]");
    TORCH_CHECK(slots.dim() == 1 && slots.scalar_type() == at::kLong
                && slots.numel() == key.size(0) && slots.is_contiguous(),
                "slots must be contiguous int64 [tokens]");
    TORCH_CHECK(formats.dim() == 1 && formats.scalar_type() == at::kByte
                && formats.is_contiguous(), "formats must be contiguous uint8 [blocks]");
    TORCH_CHECK(key_cache.dim() == 4 && key_cache.sizes() == value_cache.sizes()
                && key_cache.scalar_type() == at::kByte
                && value_cache.scalar_type() == at::kByte
                && key_cache.is_contiguous() && value_cache.is_contiguous(),
                "KV cache must be contiguous uint8 [blocks, slots, heads, dim]");
    TORCH_CHECK(key_cache.size(0) == formats.numel()
                && key_cache.size(2) == key.size(1)
                && key_cache.size(3) == key.size(2), "KV cache shape mismatch");
    TORCH_CHECK(key.device() == value.device() && key.device() == slots.device()
                && key.device() == formats.device() && key.device() == key_cache.device()
                && key.device() == value_cache.device(), "all tensors must share one NPU");
    TORCH_CHECK(key.numel() <= std::numeric_limits<uint32_t>::max(),
                "PSP-KV native quantizer input is too large");
    if (key.numel() == 0) return;
    const c10::DeviceGuard guard(key.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    const uint32_t elements_per_token = static_cast<uint32_t>(key.size(1) * key.size(2));
    // Different cores must not write into the same 64-byte DCache line. If
    // token strides are not line-aligned, use one core for correctness.
    const uint32_t core_count = elements_per_token % 64 == 0 ? 40 : 1;
    PspkvQuantizeScatterBF16<<<core_count, nullptr, stream>>>(
        (GM_ADDR)key.const_data_ptr(), (GM_ADDR)value.const_data_ptr(),
        (GM_ADDR)slots.const_data_ptr(), (GM_ADDR)formats.const_data_ptr(),
        (GM_ADDR)key_cache.mutable_data_ptr(), (GM_ADDR)value_cache.mutable_data_ptr(),
        static_cast<uint32_t>(key.numel()),
        elements_per_token,
        static_cast<uint32_t>(key_cache.size(1)));
}

at::Tensor decode_fp8(const at::Tensor& bytes, const at::Tensor& formats) {
    TORCH_CHECK(bytes.device().type() == c10::DeviceType::PrivateUse1
                && formats.device() == bytes.device(), "PSP-KV native decoder needs NPU tensors");
    TORCH_CHECK(bytes.dim() == 4 && bytes.scalar_type() == at::kByte
                && bytes.is_contiguous(), "bytes must be contiguous uint8 [blocks, slots, heads, dim]");
    TORCH_CHECK(formats.dim() == 1 && formats.scalar_type() == at::kByte
                && formats.is_contiguous() && formats.numel() == bytes.size(0),
                "formats must be contiguous uint8 [blocks]");
    TORCH_CHECK(bytes.numel() <= std::numeric_limits<uint32_t>::max(),
                "PSP-KV native decoder input is too large");
    auto output = at::empty(bytes.sizes(), bytes.options().dtype(at::kFloat));
    if (bytes.numel() == 0) return output;
    const c10::DeviceGuard guard(bytes.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    PspkvDecodeFP8<<<40, nullptr, stream>>>(
        (GM_ADDR)bytes.const_data_ptr(), (GM_ADDR)formats.const_data_ptr(),
        (GM_ADDR)output.mutable_data_ptr(), static_cast<uint32_t>(bytes.numel()),
        static_cast<uint32_t>(bytes.numel() / bytes.size(0)));
    return output;
}

void check_decode_inputs(const at::Tensor& query_or_probs,
                         const at::Tensor& cache, const at::Tensor& formats,
                         const at::Tensor& block_ids, int64_t seq_len,
                         int64_t heads, int64_t padded_seq_len) {
    TORCH_CHECK(cache.device().type() == c10::DeviceType::PrivateUse1
                && cache.dim() == 4 && cache.scalar_type() == at::kByte
                && cache.is_contiguous(), "decode cache must be contiguous NPU uint8");
    TORCH_CHECK(query_or_probs.device() == cache.device()
                && formats.device() == cache.device()
                && block_ids.device() == cache.device(),
                "decode tensors must share one NPU");
    TORCH_CHECK(formats.dim() == 1 && formats.scalar_type() == at::kByte
                && formats.is_contiguous() && formats.numel() == cache.size(0),
                "decode formats must match physical blocks");
    TORCH_CHECK(block_ids.dim() == 1 && block_ids.scalar_type() == at::kInt
                && block_ids.is_contiguous(), "decode block IDs must be contiguous int32");
    TORCH_CHECK(seq_len > 0 && seq_len <= block_ids.numel() * cache.size(1)
                && heads > 0 && heads % cache.size(2) == 0,
                "decode sequence length or GQA heads are invalid");
    TORCH_CHECK(padded_seq_len >= seq_len && padded_seq_len % 16 == 0,
                "decode padded length must be 64-byte aligned");
    TORCH_CHECK(cache.size(3) > 0 && cache.numel() <= std::numeric_limits<uint32_t>::max()
                && seq_len <= std::numeric_limits<uint32_t>::max()
                && heads <= std::numeric_limits<uint32_t>::max(),
                "decode tensor dimensions exceed kernel limits");
}

at::Tensor decode_scores_bf16(const at::Tensor& query, const at::Tensor& key_cache,
                              const at::Tensor& formats, const at::Tensor& block_ids,
                              int64_t seq_len, double scale) {
    const int64_t heads = query.size(1);
    const int64_t padded = (seq_len + 15) / 16 * 16;
    check_decode_inputs(query, key_cache, formats, block_ids, seq_len, heads, padded);
    TORCH_CHECK(query.dim() == 3 && query.size(0) == 1
                && query.size(2) == key_cache.size(3)
                && query.scalar_type() == at::kBFloat16 && query.is_contiguous(),
                "decode query must be contiguous BF16 [1, heads, dim]");
    auto scores = at::empty({heads, padded}, query.options().dtype(at::kFloat));
    const c10::DeviceGuard guard(query.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    const uint32_t cores = static_cast<uint32_t>(heads < 40 ? heads : 40);
    PspkvDecodeScoresBF16<<<cores, nullptr, stream>>>(
        (GM_ADDR)query.const_data_ptr(), (GM_ADDR)key_cache.const_data_ptr(),
        (GM_ADDR)formats.const_data_ptr(), (GM_ADDR)block_ids.const_data_ptr(),
        (GM_ADDR)scores.mutable_data_ptr(), static_cast<uint32_t>(seq_len),
        static_cast<uint32_t>(padded), static_cast<uint32_t>(key_cache.size(1)),
        static_cast<uint32_t>(key_cache.size(2)), static_cast<uint32_t>(key_cache.size(3)),
        static_cast<uint32_t>(heads), static_cast<float>(scale));
    return scores;
}

at::Tensor decode_weighted_value(const at::Tensor& probabilities,
                                 const at::Tensor& value_cache,
                                 const at::Tensor& formats, const at::Tensor& block_ids,
                                 int64_t seq_len) {
    TORCH_CHECK(probabilities.dim() == 2, "probabilities must be [heads, padded_seq]");
    const int64_t heads = probabilities.size(0);
    const int64_t padded = probabilities.size(1);
    check_decode_inputs(probabilities, value_cache, formats, block_ids,
                        seq_len, heads, padded);
    TORCH_CHECK(probabilities.scalar_type() == at::kFloat
                && probabilities.is_contiguous(),
                "probabilities must be contiguous float32");
    auto output = at::empty({1, heads, value_cache.size(3)},
                            probabilities.options().dtype(at::kFloat));
    const c10::DeviceGuard guard(probabilities.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    // Each head writes independent cache lines only for aligned head strides.
    const uint32_t cores = value_cache.size(3) % 16 == 0
                               ? static_cast<uint32_t>(heads < 40 ? heads : 40) : 1;
    PspkvDecodeWeightedValue<<<cores, nullptr, stream>>>(
        (GM_ADDR)probabilities.const_data_ptr(), (GM_ADDR)value_cache.const_data_ptr(),
        (GM_ADDR)formats.const_data_ptr(), (GM_ADDR)block_ids.const_data_ptr(),
        (GM_ADDR)output.mutable_data_ptr(), static_cast<uint32_t>(seq_len),
        static_cast<uint32_t>(padded), static_cast<uint32_t>(value_cache.size(1)),
        static_cast<uint32_t>(value_cache.size(2)),
        static_cast<uint32_t>(value_cache.size(3)), static_cast<uint32_t>(heads));
    return output;
}

uint32_t packed_target_dtype(at::ScalarType dtype) {
    if (dtype == at::kBFloat16) return 0;
    if (dtype == at::kHalf) return 1;
    if (dtype == at::kFloat8_e4m3fn) return 2;
    if (dtype == at::kFloat8_e5m2) return 3;
    TORCH_CHECK(false, "packed PSP-KV target must be BF16, FP16 or FP8");
}

uint32_t packed_scale_groups(const at::Tensor& scales,
                             int64_t format_generation, int64_t blocks,
                             int64_t kv_heads, int64_t head_dim) {
    if (scales.dim() != 4) return 0;
    TORCH_CHECK(format_generation == 3 && scales.size(0) == blocks
                && scales.size(1) == 2 && scales.size(2) == kv_heads
                && scales.size(3) > 0 && head_dim % scales.size(3) == 0,
                "grouped FP4 scales must be [blocks, 2, KV heads, groups]");
    return static_cast<uint32_t>(scales.size(3));
}

void check_packed_inputs(const at::Tensor& cache,
                         const at::Tensor& block_tables,
                         const at::Tensor& context_lens,
                         const at::Tensor& formats,
                         const at::Tensor& offsets,
                         const at::Tensor& scales,
                         int64_t format_generation, int64_t kv_heads,
                         int64_t head_dim, int64_t block_size) {
    TORCH_CHECK(cache.device().type() == c10::DeviceType::PrivateUse1
                && cache.scalar_type() == at::kByte && cache.dim() == 1
                && cache.is_contiguous(), "packed KV must be a contiguous NPU byte arena");
    TORCH_CHECK(block_tables.device() == cache.device()
                && context_lens.device() == cache.device()
                && formats.device() == cache.device()
                && offsets.device() == cache.device()
                && scales.device() == cache.device(),
                "packed inputs must share one NPU");
    TORCH_CHECK(block_tables.dim() == 2 && block_tables.scalar_type() == at::kInt
                && block_tables.is_contiguous()
                && context_lens.dim() == 1 && context_lens.scalar_type() == at::kInt
                && context_lens.is_contiguous()
                && context_lens.numel() == block_tables.size(0),
                "packed block tables and context lengths must be int32");
    TORCH_CHECK(formats.dim() == 1 && formats.scalar_type() == at::kByte
                && formats.is_contiguous()
                && offsets.dim() == 1 && offsets.scalar_type() == at::kInt
                && offsets.is_contiguous() && offsets.numel() == formats.numel(),
                "packed formats and offsets must match physical blocks");
    TORCH_CHECK(scales.scalar_type() == at::kFloat && scales.is_contiguous()
                && (format_generation == 0 ||
                    (scales.dim() == 2 && scales.size(0) == formats.numel()
                     && scales.size(1) == kv_heads)
                    || (format_generation == 3 && scales.dim() == 4
                        && scales.size(0) == formats.numel()
                        && scales.size(1) == 2 && scales.size(2) == kv_heads)),
                "enhanced/BTKV require float32 scales [blocks, KV heads]");
    packed_scale_groups(scales, format_generation, formats.numel(),
                        kv_heads, head_dim);
    TORCH_CHECK(format_generation >= 0 && format_generation <= 3,
                "packed format generation must be basic, enhanced, BTKV or scaled-basic");
    TORCH_CHECK(kv_heads > 0 && head_dim > 0 && block_size > 0
                && block_size % 16 == 0 && head_dim % 2 == 0
                && block_tables.size(0) > 0 && block_tables.size(1) > 0,
                "packed cache dimensions must be positive and aligned");
    TORCH_CHECK(cache.numel() <= std::numeric_limits<uint32_t>::max()
                && block_tables.size(1) * block_size
                    <= std::numeric_limits<uint32_t>::max(),
                "packed cache exceeds native indexing limits");
}

at::Tensor packed_scores(const at::Tensor& query, const at::Tensor& key_cache,
                         const at::Tensor& block_tables,
                         const at::Tensor& context_lens,
                         const at::Tensor& formats, const at::Tensor& offsets,
                         const at::Tensor& scales, int64_t format_generation,
                         int64_t kv_heads, int64_t block_size, double softmax_scale) {
    TORCH_CHECK(query.dim() == 3 && query.size(0) == block_tables.size(0)
                && query.is_contiguous() && query.device() == key_cache.device(),
                "packed decode query must be contiguous [sequences, heads, dim]");
    const uint32_t target_dtype = packed_target_dtype(query.scalar_type());
    const int64_t heads = query.size(1);
    const int64_t head_dim = query.size(2);
    check_packed_inputs(key_cache, block_tables, context_lens, formats, offsets,
                        scales, format_generation, kv_heads, head_dim, block_size);
    const uint32_t scale_groups = packed_scale_groups(
        scales, format_generation, formats.numel(), kv_heads, head_dim);
    TORCH_CHECK(heads > 0 && heads % kv_heads == 0
                && heads * query.size(0) <= std::numeric_limits<uint32_t>::max(),
                "packed query heads must divide KV heads and fit native indexing");
    const int64_t sequence_stride = block_tables.size(1) * block_size;
    auto scores = at::empty({query.size(0), heads, sequence_stride},
                            query.options().dtype(at::kFloat));
    const c10::DeviceGuard guard(query.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    const int64_t rows = query.size(0) * heads;
    const uint32_t cores = static_cast<uint32_t>(rows < 40 ? rows : 40);
    PspkvPackedScores<<<cores, nullptr, stream>>>(
        (GM_ADDR)query.const_data_ptr(), (GM_ADDR)key_cache.const_data_ptr(),
        (GM_ADDR)block_tables.const_data_ptr(), (GM_ADDR)context_lens.const_data_ptr(),
        (GM_ADDR)formats.const_data_ptr(), (GM_ADDR)offsets.const_data_ptr(),
        (GM_ADDR)scales.const_data_ptr(), (GM_ADDR)scores.mutable_data_ptr(),
        static_cast<uint32_t>(query.size(0)), static_cast<uint32_t>(heads),
        static_cast<uint32_t>(kv_heads), static_cast<uint32_t>(head_dim),
        static_cast<uint32_t>(block_size), static_cast<uint32_t>(block_tables.size(1)),
        target_dtype, static_cast<uint32_t>(format_generation), scale_groups,
        static_cast<float>(softmax_scale));
    return scores;
}

at::Tensor packed_weighted_value(const at::Tensor& probabilities,
                                 const at::Tensor& value_cache,
                                 const at::Tensor& block_tables,
                                 const at::Tensor& context_lens,
                                 const at::Tensor& formats,
                                 const at::Tensor& offsets,
                                 const at::Tensor& scales,
                                 int64_t format_generation,
                                 int64_t kv_heads, int64_t head_dim,
                                 int64_t block_size, int64_t target_dtype) {
    TORCH_CHECK(probabilities.dim() == 3
                && probabilities.scalar_type() == at::kFloat
                && probabilities.is_contiguous()
                && probabilities.device() == value_cache.device()
                && probabilities.size(0) == block_tables.size(0)
                && probabilities.size(2) == block_tables.size(1) * block_size,
                "packed probabilities must be float32 [sequences, heads, capacity]");
    check_packed_inputs(value_cache, block_tables, context_lens, formats, offsets,
                        scales, format_generation, kv_heads, head_dim, block_size);
    const uint32_t scale_groups = packed_scale_groups(
        scales, format_generation, formats.numel(), kv_heads, head_dim);
    TORCH_CHECK(target_dtype >= 0 && target_dtype <= 3
                && probabilities.size(1) % kv_heads == 0,
                "packed target dtype or GQA heads are invalid");
    const int64_t rows = probabilities.size(0) * probabilities.size(1);
    auto output = at::empty({probabilities.size(0), probabilities.size(1), head_dim},
                            probabilities.options());
    const c10::DeviceGuard guard(probabilities.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    const uint32_t cores = static_cast<uint32_t>(
        head_dim % 16 == 0 ? (rows < 40 ? rows : 40) : 1);
    PspkvPackedWeightedValue<<<cores, nullptr, stream>>>(
        (GM_ADDR)probabilities.const_data_ptr(), (GM_ADDR)value_cache.const_data_ptr(),
        (GM_ADDR)block_tables.const_data_ptr(), (GM_ADDR)context_lens.const_data_ptr(),
        (GM_ADDR)formats.const_data_ptr(), (GM_ADDR)offsets.const_data_ptr(),
        (GM_ADDR)scales.const_data_ptr(), (GM_ADDR)output.mutable_data_ptr(),
        static_cast<uint32_t>(probabilities.size(0)),
        static_cast<uint32_t>(probabilities.size(1)),
        static_cast<uint32_t>(kv_heads), static_cast<uint32_t>(head_dim),
        static_cast<uint32_t>(block_size), static_cast<uint32_t>(block_tables.size(1)),
        static_cast<uint32_t>(target_dtype),
        static_cast<uint32_t>(format_generation), scale_groups);
    return output;
}

void cast_fp8_output(const at::Tensor& source, at::Tensor& output) {
    TORCH_CHECK(source.device().type() == c10::DeviceType::PrivateUse1
                && source.device() == output.device()
                && source.scalar_type() == at::kFloat
                && source.is_contiguous() && output.is_contiguous()
                && source.sizes() == output.sizes()
                && (output.scalar_type() == at::kFloat8_e4m3fn
                    || output.scalar_type() == at::kFloat8_e5m2),
                "FP8 output conversion requires matching NPU FP32 and FP8 tensors");
    TORCH_CHECK(source.numel() <= std::numeric_limits<uint32_t>::max(),
                "FP8 output exceeds native indexing limit");
    if (source.numel() == 0) return;
    const c10::DeviceGuard guard(source.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    PspkvCastFP8Output<<<40, nullptr, stream>>>(
        (GM_ADDR)source.const_data_ptr(), (GM_ADDR)output.mutable_data_ptr(),
        static_cast<uint32_t>(source.numel()),
        output.scalar_type() == at::kFloat8_e5m2 ? 2U : 1U);
}

void packed_scatter(const at::Tensor& prefill, at::Tensor& key_cache,
                    at::Tensor& value_cache, const at::Tensor& slot_mapping,
                    const at::Tensor& formats, const at::Tensor& offsets,
                    at::Tensor& scales, int64_t num_tokens,
                    int64_t block_size, int64_t format_generation,
                    bool preserve_scales) {
    TORCH_CHECK(prefill.device().type() == c10::DeviceType::PrivateUse1
                && prefill.dim() == 4 && prefill.size(1) == 2
                && prefill.is_contiguous() && num_tokens >= 0
                && num_tokens <= prefill.size(0),
                "packed scatter needs NPU [tokens, 2, KV heads, dim]");
    const uint32_t target_dtype = packed_target_dtype(prefill.scalar_type());
    TORCH_CHECK(key_cache.device() == prefill.device()
                && value_cache.device() == prefill.device()
                && slot_mapping.device() == prefill.device()
                && formats.device() == prefill.device()
                && offsets.device() == prefill.device()
                && scales.device() == prefill.device()
                && key_cache.dim() == 1 && value_cache.dim() == 1
                && key_cache.scalar_type() == at::kByte
                && value_cache.scalar_type() == at::kByte
                && key_cache.is_contiguous() && value_cache.is_contiguous()
                && slot_mapping.dim() == 1
                && slot_mapping.scalar_type() == at::kLong
                && slot_mapping.is_contiguous()
                && slot_mapping.numel() >= num_tokens
                && formats.dim() == 1 && formats.scalar_type() == at::kByte
                && formats.is_contiguous()
                && offsets.dim() == 1 && offsets.scalar_type() == at::kInt
                && offsets.is_contiguous() && offsets.numel() == formats.numel()
                && scales.scalar_type() == at::kFloat && scales.is_contiguous()
                && ((scales.dim() == 2 && scales.size(0) == formats.numel()
                     && scales.size(1) == prefill.size(2))
                    || (format_generation == 3 && preserve_scales
                        && scales.dim() == 4
                        && scales.size(0) == formats.numel()
                        && scales.size(1) == 2
                        && scales.size(2) == prefill.size(2))),
                "packed scatter tensor types or shapes mismatch");
    const uint32_t scale_groups = packed_scale_groups(
        scales, format_generation, formats.numel(), prefill.size(2),
        prefill.size(3));
    TORCH_CHECK(block_size > 0 && block_size % 2 == 0
                && prefill.size(2) > 0 && prefill.size(3) > 0
                && prefill.size(3) % 2 == 0
                && format_generation >= 0 && format_generation <= 3
                && prefill.numel() <= std::numeric_limits<uint32_t>::max()
                && key_cache.numel() <= std::numeric_limits<uint32_t>::max()
                && value_cache.numel() <= std::numeric_limits<uint32_t>::max(),
                "packed scatter dimensions exceed supported limits");
    if (num_tokens == 0) return;
    const c10::DeviceGuard guard(prefill.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    const uint32_t cores = preserve_scales && format_generation == 3
        && prefill.size(3) % 128 == 0
        ? static_cast<uint32_t>(num_tokens < 40 ? num_tokens : 40) : 1U;
    PspkvPackedScatter<<<cores, nullptr, stream>>>(
        (GM_ADDR)prefill.const_data_ptr(), (GM_ADDR)key_cache.mutable_data_ptr(),
        (GM_ADDR)value_cache.mutable_data_ptr(), (GM_ADDR)slot_mapping.const_data_ptr(),
        (GM_ADDR)formats.const_data_ptr(), (GM_ADDR)offsets.const_data_ptr(),
        (GM_ADDR)scales.mutable_data_ptr(), static_cast<uint32_t>(num_tokens),
        static_cast<uint32_t>(prefill.size(2)), static_cast<uint32_t>(prefill.size(3)),
        static_cast<uint32_t>(block_size), target_dtype,
        static_cast<uint32_t>(format_generation), preserve_scales ? 1U : 0U,
        scale_groups);
}

std::tuple<at::Tensor, at::Tensor> packed_dequant(
    const at::Tensor& key_cache, const at::Tensor& value_cache,
    const at::Tensor& offsets, const at::Tensor& formats,
    const at::Tensor& scales, int64_t block_size,
    int64_t head_dim, int64_t target_dtype,
    int64_t format_generation) {
    const int64_t blocks = formats.numel();
    TORCH_CHECK(scales.dim() == 2 || scales.dim() == 4,
                "packed dequant scales must be per-head or grouped");
    const int64_t kv_heads = scales.dim() == 4 ? scales.size(2) : scales.size(1);
    TORCH_CHECK(key_cache.device().type() == c10::DeviceType::PrivateUse1
                && value_cache.device() == key_cache.device()
                && offsets.device() == key_cache.device()
                && formats.device() == key_cache.device()
                && scales.device() == key_cache.device()
                && key_cache.dim() == 1 && value_cache.dim() == 1
                && key_cache.scalar_type() == at::kByte
                && value_cache.scalar_type() == at::kByte
                && key_cache.is_contiguous() && value_cache.is_contiguous()
                && offsets.dim() == 1 && offsets.scalar_type() == at::kInt
                && offsets.is_contiguous() && offsets.numel() == blocks
                && formats.dim() == 1 && formats.scalar_type() == at::kByte
                && formats.is_contiguous()
                && scales.scalar_type() == at::kFloat
                && scales.is_contiguous() && scales.size(0) == blocks,
                "packed dequant tensors must be contiguous NPU cache arrays");
    const uint32_t scale_groups = packed_scale_groups(
        scales, format_generation, blocks, kv_heads, head_dim);
    TORCH_CHECK(blocks > 0 && kv_heads > 0 && block_size > 0
                && head_dim > 0 && head_dim % 2 == 0
                && target_dtype >= 0 && target_dtype <= 3
                && format_generation >= 0 && format_generation <= 3
                && blocks * kv_heads * block_size * head_dim
                    <= std::numeric_limits<uint32_t>::max(),
                "packed dequant dimensions are invalid");
    auto options = key_cache.options().dtype(at::kFloat);
    auto key_output = at::empty({blocks, kv_heads, block_size, head_dim}, options);
    auto value_output = at::empty_like(key_output);
    const c10::DeviceGuard guard(key_cache.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    PspkvPackedDequant<<<40, nullptr, stream>>>(
        (GM_ADDR)key_cache.const_data_ptr(), (GM_ADDR)value_cache.const_data_ptr(),
        (GM_ADDR)offsets.const_data_ptr(), (GM_ADDR)formats.const_data_ptr(),
        (GM_ADDR)scales.const_data_ptr(), (GM_ADDR)key_output.mutable_data_ptr(),
        (GM_ADDR)value_output.mutable_data_ptr(),
        static_cast<uint32_t>(key_output.numel()),
        static_cast<uint32_t>(kv_heads), static_cast<uint32_t>(block_size),
        static_cast<uint32_t>(head_dim), static_cast<uint32_t>(target_dtype),
        static_cast<uint32_t>(format_generation), scale_groups);
    return {key_output, value_output};
}

void check_uniform_inputs(const at::Tensor& query, const at::Tensor& cache,
                          const at::Tensor& tables, const at::Tensor& lengths) {
    TORCH_CHECK(query.device().type() == c10::DeviceType::PrivateUse1
                && query.dim() == 3 && query.is_contiguous()
                && cache.device() == query.device() && cache.dim() == 4
                && cache.is_contiguous() && cache.scalar_type() == query.scalar_type()
                && cache.size(3) == query.size(2)
                && tables.device() == query.device() && tables.dim() == 2
                && tables.scalar_type() == at::kInt && tables.is_contiguous()
                && lengths.device() == query.device() && lengths.dim() == 1
                && lengths.scalar_type() == at::kInt && lengths.is_contiguous()
                && query.size(0) == tables.size(0)
                && query.size(0) == lengths.numel()
                && query.size(1) > 0 && cache.size(2) > 0
                && cache.size(1) > 0 && query.size(1) % cache.size(1) == 0
                && tables.size(1) > 0
                && tables.size(1) * cache.size(2)
                    <= std::numeric_limits<uint32_t>::max(),
                "uniform attention requires matching dense NPU Q/K/V metadata");
    packed_target_dtype(query.scalar_type());
}

at::Tensor uniform_scores(const at::Tensor& query, const at::Tensor& key_cache,
                          const at::Tensor& block_tables,
                          const at::Tensor& context_lens, double softmax_scale) {
    check_uniform_inputs(query, key_cache, block_tables, context_lens);
    const int64_t rows = query.size(0) * query.size(1);
    auto scores = at::empty({query.size(0), query.size(1),
                             block_tables.size(1) * key_cache.size(2)},
                            query.options().dtype(at::kFloat));
    const c10::DeviceGuard guard(query.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    PspkvUniformScores<<<static_cast<uint32_t>(rows < 40 ? rows : 40),
                         nullptr, stream>>>(
        (GM_ADDR)query.const_data_ptr(), (GM_ADDR)key_cache.const_data_ptr(),
        (GM_ADDR)block_tables.const_data_ptr(),
        (GM_ADDR)context_lens.const_data_ptr(), (GM_ADDR)scores.mutable_data_ptr(),
        static_cast<uint32_t>(query.size(0)), static_cast<uint32_t>(query.size(1)),
        static_cast<uint32_t>(key_cache.size(1)),
        static_cast<uint32_t>(key_cache.size(3)),
        static_cast<uint32_t>(key_cache.size(2)),
        static_cast<uint32_t>(block_tables.size(1)),
        packed_target_dtype(query.scalar_type()),
        static_cast<float>(softmax_scale));
    return scores;
}

at::Tensor uniform_weighted_value(const at::Tensor& probabilities,
                                  const at::Tensor& value_cache,
                                  const at::Tensor& block_tables,
                                  const at::Tensor& context_lens,
                                  int64_t target_dtype) {
    TORCH_CHECK(probabilities.dim() == 3
                && probabilities.scalar_type() == at::kFloat
                && probabilities.is_contiguous()
                && target_dtype >= 0 && target_dtype <= 3
                && probabilities.size(2) == block_tables.size(1) * value_cache.size(2),
                "uniform probabilities must match dense cache capacity");
    // The cache is the chosen target dtype; validate it through a view-free
    // dummy tensor comparison rather than attempting a device-side cast.
    TORCH_CHECK(value_cache.device() == probabilities.device()
                && block_tables.device() == probabilities.device()
                && context_lens.device() == probabilities.device()
                && value_cache.dim() == 4 && value_cache.is_contiguous()
                && block_tables.dim() == 2 && block_tables.scalar_type() == at::kInt
                && block_tables.is_contiguous()
                && context_lens.dim() == 1
                && context_lens.scalar_type() == at::kInt
                && context_lens.is_contiguous()
                && probabilities.size(0) == context_lens.numel()
                && probabilities.size(0) == block_tables.size(0)
                && value_cache.size(1) > 0
                && value_cache.size(2) > 0
                && probabilities.size(1) > 0
                && probabilities.size(1) % value_cache.size(1) == 0
                && packed_target_dtype(value_cache.scalar_type()) == target_dtype,
                "uniform V cache and probability metadata mismatch");
    const int64_t rows = probabilities.size(0) * probabilities.size(1);
    auto output = at::empty({probabilities.size(0), probabilities.size(1),
                             value_cache.size(3)},
                            probabilities.options());
    const c10::DeviceGuard guard(probabilities.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    PspkvUniformWeightedValue<<<static_cast<uint32_t>(rows < 40 ? rows : 40),
                                 nullptr, stream>>>(
        (GM_ADDR)probabilities.const_data_ptr(),
        (GM_ADDR)value_cache.const_data_ptr(),
        (GM_ADDR)block_tables.const_data_ptr(),
        (GM_ADDR)context_lens.const_data_ptr(),
        (GM_ADDR)output.mutable_data_ptr(),
        static_cast<uint32_t>(probabilities.size(0)),
        static_cast<uint32_t>(probabilities.size(1)),
        static_cast<uint32_t>(value_cache.size(1)),
        static_cast<uint32_t>(value_cache.size(3)),
        static_cast<uint32_t>(value_cache.size(2)),
        static_cast<uint32_t>(block_tables.size(1)),
        static_cast<uint32_t>(target_dtype));
    return output;
}

// ---------------------------------------------------------------------------
// Row-batched, UB-staged variants of the packed decode kernels. They issue
// DataCopy batches instead of one global load per element and decode bytes
// through lookup tables generated by the Python reference codec, so every
// arithmetic step stays in the same order as the scalar kernels and the
// results remain bit-identical. Formats 1/2/3 (E4M3/E5M2/FP4) use the staged
// path; the lossless format 0 falls back to scalar global reads.
// ---------------------------------------------------------------------------
constexpr uint32_t PSPKV_ROWS_PER_CHUNK = 8;

at::Tensor packed_scores_vec(const at::Tensor& query,
                             const at::Tensor& key_cache,
                             const at::Tensor& block_tables,
                             const at::Tensor& context_lens,
                             const at::Tensor& formats,
                             const at::Tensor& offsets,
                             const at::Tensor& scales,
                             const at::Tensor& e4m3_table,
                             const at::Tensor& e5m2_table,
                             const at::Tensor& fp4_table,
                             int64_t format_generation,
                             int64_t kv_heads, int64_t block_size,
                             double softmax_scale) {
    TORCH_CHECK(query.dim() == 3 && query.size(0) == block_tables.size(0)
                && query.is_contiguous() && query.device() == key_cache.device(),
                "vectorized packed query must be contiguous [sequences, heads, dim]");
    const uint32_t target_dtype = packed_target_dtype(query.scalar_type());
    const int64_t heads = query.size(1);
    const int64_t head_dim = query.size(2);
    check_packed_inputs(key_cache, block_tables, context_lens, formats, offsets,
                        scales, format_generation, kv_heads, head_dim, block_size);
    TORCH_CHECK(e4m3_table.device() == query.device()
                && e5m2_table.device() == query.device()
                && fp4_table.device() == query.device()
                && e4m3_table.scalar_type() == at::kFloat
                && e5m2_table.scalar_type() == at::kFloat
                && fp4_table.scalar_type() == at::kFloat
                && e4m3_table.numel() == 256 && e5m2_table.numel() == 256
                && fp4_table.numel() == 256,
                "vectorized packed scores need FP32 lookup tables [256]/[256]/[256]");
    const uint32_t scale_groups = packed_scale_groups(
        scales, format_generation, formats.numel(), kv_heads, head_dim);
    TORCH_CHECK(heads > 0 && heads % kv_heads == 0
                && heads * query.size(0) <= std::numeric_limits<uint32_t>::max(),
                "vectorized packed query heads must divide KV heads");
    const int64_t sequence_stride = block_tables.size(1) * block_size;
    auto scores = at::empty({query.size(0), heads, sequence_stride},
                            query.options().dtype(at::kFloat));
    const c10::DeviceGuard guard(query.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    const int64_t rows = query.size(0) * heads;
    const uint32_t cores = static_cast<uint32_t>(rows < 40 ? rows : 40);
    PspkvPackedScoresVec<<<cores, nullptr, stream>>>(
        (GM_ADDR)query.const_data_ptr(), (GM_ADDR)key_cache.const_data_ptr(),
        (GM_ADDR)block_tables.const_data_ptr(),
        (GM_ADDR)context_lens.const_data_ptr(),
        (GM_ADDR)formats.const_data_ptr(), (GM_ADDR)offsets.const_data_ptr(),
        (GM_ADDR)scales.const_data_ptr(),
        (GM_ADDR)e4m3_table.const_data_ptr(),
        (GM_ADDR)e5m2_table.const_data_ptr(),
        (GM_ADDR)fp4_table.const_data_ptr(),
        (GM_ADDR)scores.mutable_data_ptr(),
        static_cast<uint32_t>(query.size(0)), static_cast<uint32_t>(heads),
        static_cast<uint32_t>(kv_heads), static_cast<uint32_t>(head_dim),
        static_cast<uint32_t>(block_size),
        static_cast<uint32_t>(block_tables.size(1)),
        target_dtype, static_cast<uint32_t>(format_generation),
        scale_groups, static_cast<float>(softmax_scale),
        static_cast<uint32_t>(key_cache.numel()));
    return scores;
}

at::Tensor packed_weighted_value_vec(const at::Tensor& probabilities,
                                     const at::Tensor& value_cache,
                                     const at::Tensor& block_tables,
                                     const at::Tensor& context_lens,
                                     const at::Tensor& formats,
                                     const at::Tensor& offsets,
                                     const at::Tensor& scales,
                                     const at::Tensor& e4m3_table,
                                     const at::Tensor& e5m2_table,
                                     const at::Tensor& fp4_table,
                                     int64_t format_generation,
                                     int64_t kv_heads, int64_t head_dim,
                                     int64_t block_size, int64_t target_dtype) {
    TORCH_CHECK(probabilities.dim() == 3
                && probabilities.scalar_type() == at::kFloat
                && probabilities.is_contiguous()
                && probabilities.device() == value_cache.device()
                && probabilities.size(0) == block_tables.size(0)
                && probabilities.size(2) == block_tables.size(1) * block_size,
                "vectorized packed probabilities must be float32 [sequences, heads, capacity]");
    check_packed_inputs(value_cache, block_tables, context_lens, formats, offsets,
                        scales, format_generation, kv_heads, head_dim, block_size);
    TORCH_CHECK(e4m3_table.device() == value_cache.device()
                && e5m2_table.device() == value_cache.device()
                && fp4_table.device() == value_cache.device()
                && e4m3_table.scalar_type() == at::kFloat
                && e5m2_table.scalar_type() == at::kFloat
                && fp4_table.scalar_type() == at::kFloat
                && e4m3_table.numel() == 256 && e5m2_table.numel() == 256
                && fp4_table.numel() == 256,
                "vectorized packed value needs FP32 lookup tables [256]/[256]/[256]");
    const uint32_t scale_groups = packed_scale_groups(
        scales, format_generation, formats.numel(), kv_heads, head_dim);
    TORCH_CHECK(target_dtype >= 0 && target_dtype <= 3
                && probabilities.size(1) % kv_heads == 0,
                "vectorized packed target dtype or GQA heads are invalid");
    const int64_t rows = probabilities.size(0) * probabilities.size(1);
    auto output = at::empty({probabilities.size(0), probabilities.size(1), head_dim},
                            probabilities.options());
    const c10::DeviceGuard guard(probabilities.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    const uint32_t cores = static_cast<uint32_t>(rows < 40 ? rows : 40);
    PspkvPackedWeightedValueVec<<<cores, nullptr, stream>>>(
        (GM_ADDR)probabilities.const_data_ptr(),
        (GM_ADDR)value_cache.const_data_ptr(),
        (GM_ADDR)block_tables.const_data_ptr(),
        (GM_ADDR)context_lens.const_data_ptr(),
        (GM_ADDR)formats.const_data_ptr(), (GM_ADDR)offsets.const_data_ptr(),
        (GM_ADDR)scales.const_data_ptr(),
        (GM_ADDR)e4m3_table.const_data_ptr(),
        (GM_ADDR)e5m2_table.const_data_ptr(),
        (GM_ADDR)fp4_table.const_data_ptr(),
        (GM_ADDR)output.mutable_data_ptr(),
        static_cast<uint32_t>(probabilities.size(0)),
        static_cast<uint32_t>(probabilities.size(1)),
        static_cast<uint32_t>(kv_heads), static_cast<uint32_t>(head_dim),
        static_cast<uint32_t>(block_size),
        static_cast<uint32_t>(block_tables.size(1)),
        static_cast<uint32_t>(target_dtype),
        static_cast<uint32_t>(format_generation), scale_groups,
        static_cast<uint32_t>(value_cache.numel()));
    return output;
}

at::Tensor packed_fused_decode(const at::Tensor& query,
                               const at::Tensor& key_cache,
                               const at::Tensor& value_cache,
                               const at::Tensor& block_tables,
                               const at::Tensor& context_lens,
                               const at::Tensor& formats,
                               const at::Tensor& offsets,
                               const at::Tensor& scales,
                               int64_t kv_heads, int64_t block_size,
                               double softmax_scale) {
    TORCH_CHECK(query.dim() == 3 && query.is_contiguous()
                && query.size(0) == block_tables.size(0)
                && query.device() == key_cache.device(),
                "fused decode query must be contiguous [sequences, heads, dim]");
    const uint32_t target_dtype = packed_target_dtype(query.scalar_type());
    const int64_t heads = query.size(1);
    const int64_t head_dim = query.size(2);
    check_packed_inputs(key_cache, block_tables, context_lens, formats, offsets,
                        scales, 3, kv_heads, head_dim, block_size);
    TORCH_CHECK(value_cache.device() == key_cache.device()
                && value_cache.scalar_type() == at::kByte
                && value_cache.dim() == 1 && value_cache.is_contiguous(),
                "fused decode V must be a contiguous NPU byte arena");
    TORCH_CHECK(heads > 0 && heads % kv_heads == 0
                && heads * query.size(0) <= std::numeric_limits<uint32_t>::max(),
                "fused decode query heads must divide KV heads");
    const int64_t sequence_stride = block_tables.size(1) * block_size;
    TORCH_CHECK(sequence_stride > 0 && sequence_stride <= 4096
                && sequence_stride % 8 == 0,
                "fused decode supports 8-aligned sequence capacity <= 4096");
    const uint32_t scale_groups = packed_scale_groups(
        scales, 3, formats.numel(), kv_heads, head_dim);
    auto output = at::empty({query.size(0), heads, head_dim},
                            query.options().dtype(at::kFloat));
    const c10::DeviceGuard guard(query.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    const int64_t rows = query.size(0) * heads;
    const uint32_t cores = head_dim % 16 == 0
        ? static_cast<uint32_t>(rows < 40 ? rows : 40) : 1;
    PspkvPackedFusedDecode<<<cores, nullptr, stream>>>(
        (GM_ADDR)query.const_data_ptr(), (GM_ADDR)key_cache.const_data_ptr(),
        (GM_ADDR)value_cache.const_data_ptr(),
        (GM_ADDR)block_tables.const_data_ptr(),
        (GM_ADDR)context_lens.const_data_ptr(),
        (GM_ADDR)formats.const_data_ptr(), (GM_ADDR)offsets.const_data_ptr(),
        (GM_ADDR)scales.const_data_ptr(), (GM_ADDR)output.mutable_data_ptr(),
        static_cast<uint32_t>(query.size(0)), static_cast<uint32_t>(heads),
        static_cast<uint32_t>(kv_heads), static_cast<uint32_t>(head_dim),
        static_cast<uint32_t>(block_size),
        static_cast<uint32_t>(block_tables.size(1)), target_dtype,
        scale_groups, static_cast<float>(softmax_scale));
    return output;
}

void packed_scatter_parallel(const at::Tensor& prefill, at::Tensor& key_cache,
    at::Tensor& value_cache, const at::Tensor& slots, const at::Tensor& formats,
    const at::Tensor& offsets, const at::Tensor& scales, int64_t block_size,
    int64_t generation) {
    TORCH_CHECK(prefill.device().type() == c10::DeviceType::PrivateUse1
        && prefill.dim() == 4 && prefill.size(1) == 2
        && prefill.scalar_type() == at::kBFloat16 && prefill.is_contiguous(),
        "parallel scatter requires contiguous BF16 [tokens,2,heads,dim]");
    const int64_t tokens = prefill.size(0), heads = prefill.size(2), dim = prefill.size(3);
    TORCH_CHECK(heads > 0 && dim > 0 && dim % 128 == 0
        && block_size > 0 && block_size % 128 == 0 && generation >= 0 && generation <= 2,
        "parallel scatter needs cache-line-aligned dimensions and Basic/Enhanced/BTKV");
    TORCH_CHECK(key_cache.device() == prefill.device() && value_cache.device() == prefill.device()
        && slots.device() == prefill.device() && formats.device() == prefill.device()
        && offsets.device() == prefill.device() && scales.device() == prefill.device()
        && key_cache.scalar_type() == at::kByte && value_cache.scalar_type() == at::kByte
        && key_cache.dim() == 1 && value_cache.dim() == 1
        && key_cache.is_contiguous() && value_cache.is_contiguous()
        && slots.scalar_type() == at::kLong && slots.dim() == 1 && slots.numel() == tokens
        && slots.is_contiguous() && formats.scalar_type() == at::kByte && formats.dim() == 1
        && formats.is_contiguous() && offsets.scalar_type() == at::kInt
        && offsets.dim() == 1 && offsets.numel() == formats.numel() && offsets.is_contiguous()
        && scales.scalar_type() == at::kFloat && scales.is_contiguous()
        && scales.dim() == 2 && scales.size(0) == formats.numel() && scales.size(1) == heads,
        "parallel scatter tensors must share one NPU and compatible metadata");
    TORCH_CHECK(prefill.numel() <= std::numeric_limits<uint32_t>::max()
        && key_cache.numel() <= std::numeric_limits<uint32_t>::max()
        && value_cache.numel() <= std::numeric_limits<uint32_t>::max(), "parallel scatter exceeds indexing limits");
    if (!tokens) return;
    const c10::DeviceGuard guard(prefill.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    const int64_t jobs = tokens * heads + (generation == 0 ? tokens * heads : heads * dim);
    const uint32_t cores = static_cast<uint32_t>(jobs < 40 ? jobs : 40);
    PspkvPackedScatterParallel<false><<<cores, nullptr, stream>>>(
        (GM_ADDR)prefill.const_data_ptr(), (GM_ADDR)prefill.const_data_ptr(), (GM_ADDR)key_cache.mutable_data_ptr(),
        (GM_ADDR)value_cache.mutable_data_ptr(), (GM_ADDR)slots.const_data_ptr(),
        (GM_ADDR)formats.const_data_ptr(), (GM_ADDR)offsets.const_data_ptr(),
        (GM_ADDR)scales.const_data_ptr(), static_cast<uint32_t>(tokens),
        static_cast<uint32_t>(heads), static_cast<uint32_t>(dim),
        static_cast<uint32_t>(block_size), static_cast<uint32_t>(generation), 0, 0, 0, 0);
}

// K/V may be views into a packed QKV projection. Read their original strides
// directly: no stack, contiguous copy, or temporary source allocation.
void packed_scatter_kv(const at::Tensor& key, const at::Tensor& value,
    at::Tensor& key_cache, at::Tensor& value_cache, const at::Tensor& slots,
    const at::Tensor& formats, const at::Tensor& offsets, const at::Tensor& scales,
    int64_t block_size, int64_t generation) {
    TORCH_CHECK(key.device().type() == c10::DeviceType::PrivateUse1
        && key.dim() == 3 && value.sizes() == key.sizes()
        && key.scalar_type() == at::kBFloat16 && value.scalar_type() == at::kBFloat16
        && key.stride(2) == 1 && value.stride(2) == 1,
        "direct scatter requires BF16 [tokens,heads,dim] with contiguous dimensions");
    const int64_t tokens = key.size(0), heads = key.size(1), dim = key.size(2);
    TORCH_CHECK(heads > 0 && dim > 0 && dim % 128 == 0
        && block_size > 0 && block_size % 128 == 0 && generation >= 0 && generation <= 2,
        "direct scatter requires aligned Basic/Enhanced/BTKV geometry");
    TORCH_CHECK(value.device() == key.device() && key_cache.device() == key.device()
        && value_cache.device() == key.device() && slots.device() == key.device()
        && formats.device() == key.device() && offsets.device() == key.device()
        && scales.device() == key.device()
        && key_cache.scalar_type() == at::kByte && value_cache.scalar_type() == at::kByte
        && key_cache.dim() == 1 && value_cache.dim() == 1
        && key_cache.is_contiguous() && value_cache.is_contiguous()
        && slots.scalar_type() == at::kLong && slots.dim() == 1 && slots.numel() == tokens
        && slots.is_contiguous() && formats.scalar_type() == at::kByte && formats.dim() == 1
        && formats.is_contiguous() && offsets.scalar_type() == at::kInt
        && offsets.dim() == 1 && offsets.numel() == formats.numel() && offsets.is_contiguous()
        && scales.scalar_type() == at::kFloat && scales.is_contiguous()
        && scales.dim() == 2 && scales.size(0) == formats.numel() && scales.size(1) == heads,
        "direct scatter tensors must share one NPU and compatible metadata");
    for (const auto& tensor : {key, value}) {
        TORCH_CHECK(tensor.stride(0) >= 0 && tensor.stride(1) >= 0
            && tokens * tensor.stride(0) + heads * tensor.stride(1) + dim
               <= std::numeric_limits<uint32_t>::max(), "direct scatter source exceeds indexing limits");
    }
    TORCH_CHECK(key_cache.numel() <= std::numeric_limits<uint32_t>::max()
        && value_cache.numel() <= std::numeric_limits<uint32_t>::max(),
        "direct scatter cache exceeds indexing limits");
    if (!tokens) return;
    const c10::DeviceGuard guard(key.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    const int64_t jobs = tokens * heads + (generation == 0 ? tokens * heads : heads * dim);
    const uint32_t cores = static_cast<uint32_t>(std::min<int64_t>(jobs, 40));
    PspkvPackedScatterParallel<true><<<cores, nullptr, stream>>>(
        (GM_ADDR)key.const_data_ptr(), (GM_ADDR)value.const_data_ptr(),
        (GM_ADDR)key_cache.mutable_data_ptr(), (GM_ADDR)value_cache.mutable_data_ptr(),
        (GM_ADDR)slots.const_data_ptr(), (GM_ADDR)formats.const_data_ptr(),
        (GM_ADDR)offsets.const_data_ptr(), (GM_ADDR)scales.const_data_ptr(),
        static_cast<uint32_t>(tokens), static_cast<uint32_t>(heads), static_cast<uint32_t>(dim),
        static_cast<uint32_t>(block_size), static_cast<uint32_t>(generation),
        static_cast<uint32_t>(key.stride(0)), static_cast<uint32_t>(key.stride(1)),
        static_cast<uint32_t>(value.stride(0)), static_cast<uint32_t>(value.stride(1)));
}

void rope_scatter_kv(at::Tensor& query, const at::Tensor& key, const at::Tensor& value,
    const at::Tensor& positions, const at::Tensor& cos_sin,
    at::Tensor& key_cache, at::Tensor& value_cache, const at::Tensor& slots,
    const at::Tensor& formats, const at::Tensor& offsets, int64_t block_size,
    int64_t generation) {
    const auto device = query.device();
    TORCH_CHECK(device.type() == c10::DeviceType::PrivateUse1
        && query.dim() == 3 && key.dim() == 3 && value.sizes() == key.sizes()
        && query.size(0) == 1 && key.size(0) == 1 && query.size(2) == 128
        && key.size(2) == 128 && query.size(1) > 0 && key.size(1) > 0
        && query.is_contiguous() && key.is_contiguous() && value.is_contiguous()
        && block_size == 128 && generation >= 0 && generation <= 2,
        "RoPE scatter supports one-token NeoX BF16 heads of size 128 and 128-token pages");
    for (const auto& tensor : {query, key, value}) {
        TORCH_CHECK(tensor.device() == device && tensor.scalar_type() == at::kBFloat16,
                    "RoPE scatter requires BF16 Q/K/V on one NPU");
    }
    TORCH_CHECK(positions.device() == device && positions.scalar_type() == at::kLong
        && positions.numel() == 1 && positions.is_contiguous()
        && cos_sin.device() == device && cos_sin.dim() == 2 && cos_sin.size(1) == 128
        && cos_sin.is_contiguous() && (cos_sin.scalar_type() == at::kBFloat16 || cos_sin.scalar_type() == at::kFloat),
        "RoPE scatter requires device positions and BF16/FP32 cos-sin cache");
    TORCH_CHECK(slots.device() == device && slots.scalar_type() == at::kLong
        && slots.numel() == 1 && slots.is_contiguous()
        && formats.device() == device && formats.scalar_type() == at::kByte
        && formats.dim() == 1 && formats.is_contiguous()
        && offsets.device() == device && offsets.scalar_type() == at::kInt
        && offsets.sizes() == formats.sizes() && offsets.is_contiguous(), "invalid RoPE scatter metadata");
    for (const auto& tensor : {key_cache, value_cache}) {
        TORCH_CHECK(tensor.device() == device && tensor.scalar_type() == at::kByte
            && tensor.dim() == 1 && tensor.is_contiguous()
            && tensor.numel() <= std::numeric_limits<uint32_t>::max(), "invalid RoPE scatter arena");
    }
    const c10::DeviceGuard guard(device);
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    PspkvRopeScatter<<<40, nullptr, stream>>>(
        (GM_ADDR)query.mutable_data_ptr(), (GM_ADDR)key.const_data_ptr(), (GM_ADDR)value.const_data_ptr(),
        (GM_ADDR)positions.const_data_ptr(), (GM_ADDR)cos_sin.const_data_ptr(),
        (GM_ADDR)key_cache.mutable_data_ptr(), (GM_ADDR)value_cache.mutable_data_ptr(),
        (GM_ADDR)slots.const_data_ptr(), (GM_ADDR)formats.const_data_ptr(), (GM_ADDR)offsets.const_data_ptr(),
        query.size(1), key.size(1), 128, block_size, generation, cos_sin.scalar_type() == at::kFloat);
}

std::tuple<at::Tensor, at::Tensor> gather_paged_bf16(
    const at::Tensor& key_cache, const at::Tensor& value_cache,
    const at::Tensor& tables, const at::Tensor& lengths, const at::Tensor& formats,
    const at::Tensor& offsets, const at::Tensor& scales, int64_t generation,
    int64_t heads, int64_t dim, int64_t block_size) {
    check_packed_inputs(key_cache, tables, lengths, formats, offsets, scales,
                        generation, heads, dim, block_size);
    TORCH_CHECK(value_cache.device() == key_cache.device() && value_cache.dim() == 1
        && value_cache.scalar_type() == at::kByte && value_cache.is_contiguous()
        && value_cache.numel() <= std::numeric_limits<uint32_t>::max(),
        "gather needs a contiguous NPU V byte arena");
    TORCH_CHECK(generation >= 0 && generation <= 2 && heads > 0
        && dim > 0 && dim <= 256 && dim % 128 == 0 && block_size % 128 == 0
        && (generation == 0 || scales.dim() == 2),
        "BF16 scratch gather supports aligned Basic/Enhanced/BTKV with per-head scales");
    const int64_t pages = tables.size(0) * tables.size(1);
    const int64_t total = pages * block_size * heads * dim;
    TORCH_CHECK(total <= std::numeric_limits<uint32_t>::max(), "gather scratch exceeds indexing limits");
    auto key = at::empty({pages, block_size, heads, dim}, key_cache.options().dtype(at::kBFloat16));
    auto value = at::empty_like(key);
    const c10::DeviceGuard guard(key_cache.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    PspkvGatherPagedBF16<<<40, nullptr, stream>>>(
        (GM_ADDR)key_cache.const_data_ptr(), (GM_ADDR)value_cache.const_data_ptr(),
        (GM_ADDR)tables.const_data_ptr(), (GM_ADDR)lengths.const_data_ptr(),
        (GM_ADDR)formats.const_data_ptr(), (GM_ADDR)offsets.const_data_ptr(),
        (GM_ADDR)scales.const_data_ptr(), (GM_ADDR)key.mutable_data_ptr(),
        (GM_ADDR)value.mutable_data_ptr(), static_cast<uint32_t>(tables.size(0)),
        static_cast<uint32_t>(tables.size(1)), static_cast<uint32_t>(heads),
        static_cast<uint32_t>(dim), static_cast<uint32_t>(block_size), static_cast<uint32_t>(generation));
    return {key, value};
}

void check_tile_tables(const at::Tensor& cache, const at::Tensor& e4,
                       const at::Tensor& e5, const at::Tensor& permutation,
                       int64_t dim) {
    for (const auto& tensor : {e4, e5}) {
        TORCH_CHECK(tensor.device() == cache.device() && tensor.scalar_type() == at::kFloat
            && tensor.is_contiguous() && tensor.numel() == 256, "tile LUT must contain 256 NPU floats");
    }
    TORCH_CHECK(permutation.device() == cache.device() && permutation.scalar_type() == at::kInt
        && permutation.is_contiguous() && permutation.numel() == PSPKV_TILE * dim,
        "tile transpose map must contain 32 * dim NPU int32 byte offsets");
}

std::tuple<at::Tensor, at::Tensor> gather_paged_bf16_vec(
    const at::Tensor& key_cache, const at::Tensor& value_cache,
    const at::Tensor& tables, const at::Tensor& lengths, const at::Tensor& formats,
    const at::Tensor& offsets, const at::Tensor& scales, const at::Tensor& e4,
    const at::Tensor& e5, const at::Tensor& permutation, int64_t generation,
    int64_t heads, int64_t dim, int64_t block_size) {
    check_packed_inputs(key_cache, tables, lengths, formats, offsets, scales,
                        generation, heads, dim, block_size);
    check_tile_tables(key_cache, e4, e5, permutation, dim);
    TORCH_CHECK(value_cache.device() == key_cache.device() && value_cache.dim() == 1
        && value_cache.scalar_type() == at::kByte && value_cache.is_contiguous()
        && value_cache.numel() <= std::numeric_limits<uint32_t>::max(),
        "vector gather needs a contiguous NPU V byte arena");
    TORCH_CHECK(generation >= 0 && generation <= 2 && heads > 0
        && (dim == 128 || dim == 256) && block_size % 128 == 0
        && (generation == 0 || scales.dim() == 2), "unsupported vector gather geometry");
    const int64_t pages = tables.size(0) * tables.size(1);
    TORCH_CHECK(pages * block_size * heads * dim <= std::numeric_limits<uint32_t>::max(),
        "vector gather scratch exceeds indexing limits");
    const c10::DeviceGuard guard(key_cache.device());
    auto key = at::empty({pages, block_size, heads, dim}, key_cache.options().dtype(at::kBFloat16));
    auto value = at::empty_like(key);
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    PspkvGatherPagedBF16Vec<<<40, nullptr, stream>>>(
        (GM_ADDR)key_cache.const_data_ptr(), (GM_ADDR)value_cache.const_data_ptr(),
        (GM_ADDR)tables.const_data_ptr(), (GM_ADDR)lengths.const_data_ptr(),
        (GM_ADDR)formats.const_data_ptr(), (GM_ADDR)offsets.const_data_ptr(),
        (GM_ADDR)scales.const_data_ptr(), (GM_ADDR)e4.const_data_ptr(),
        (GM_ADDR)e5.const_data_ptr(), (GM_ADDR)permutation.const_data_ptr(),
        (GM_ADDR)key.mutable_data_ptr(), (GM_ADDR)value.mutable_data_ptr(),
        tables.size(0), tables.size(1), heads, dim, block_size, generation);
    return {key, value};
}

void gather_paged_bf16_vec_out(
    const at::Tensor& key_cache, const at::Tensor& value_cache,
    const at::Tensor& tables, const at::Tensor& lengths, const at::Tensor& formats,
    const at::Tensor& offsets, const at::Tensor& scales, const at::Tensor& e4,
    const at::Tensor& e5, const at::Tensor& permutation, int64_t generation,
    int64_t heads, int64_t dim, int64_t block_size, at::Tensor& key, at::Tensor& value) {
    check_packed_inputs(key_cache, tables, lengths, formats, offsets, scales,
                        generation, heads, dim, block_size);
    check_tile_tables(key_cache, e4, e5, permutation, dim);
    TORCH_CHECK(value_cache.device() == key_cache.device() && value_cache.dim() == 1
        && value_cache.scalar_type() == at::kByte && value_cache.is_contiguous()
        && value_cache.numel() <= std::numeric_limits<uint32_t>::max(),
        "vector gather needs a contiguous NPU V arena");
    TORCH_CHECK(generation >= 0 && generation <= 2 && heads > 0
        && (dim == 128 || dim == 256) && block_size % 128 == 0
        && (generation == 0 || scales.dim() == 2), "unsupported vector gather geometry");
    const int64_t pages = tables.size(0) * tables.size(1);
    TORCH_CHECK(pages * block_size * heads * dim <= std::numeric_limits<uint32_t>::max(),
        "vector gather scratch exceeds indexing limits");
    for (const auto& tensor : {key, value}) {
        TORCH_CHECK(tensor.device() == key_cache.device() && tensor.scalar_type() == at::kBFloat16
            && tensor.is_contiguous() && tensor.dim() == 4 && tensor.size(0) == pages
            && tensor.size(1) == block_size && tensor.size(2) == heads && tensor.size(3) == dim,
            "vector gather outputs must be BF16 [active_pages,block,heads,dim]");
    }
    const c10::DeviceGuard guard(key_cache.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    PspkvGatherPagedBF16Vec<<<40, nullptr, stream>>>(
        (GM_ADDR)key_cache.const_data_ptr(), (GM_ADDR)value_cache.const_data_ptr(),
        (GM_ADDR)tables.const_data_ptr(), (GM_ADDR)lengths.const_data_ptr(),
        (GM_ADDR)formats.const_data_ptr(), (GM_ADDR)offsets.const_data_ptr(),
        (GM_ADDR)scales.const_data_ptr(), (GM_ADDR)e4.const_data_ptr(),
        (GM_ADDR)e5.const_data_ptr(), (GM_ADDR)permutation.const_data_ptr(),
        (GM_ADDR)key.mutable_data_ptr(), (GM_ADDR)value.mutable_data_ptr(),
        tables.size(0), tables.size(1), heads, dim, block_size, generation);
}

at::Tensor tile_fused_attention(
    const at::Tensor& query, const at::Tensor& key_cache, const at::Tensor& value_cache,
    const at::Tensor& tables, const at::Tensor& lengths, const at::Tensor& formats,
    const at::Tensor& offsets, const at::Tensor& scales, const at::Tensor& e4,
    const at::Tensor& e5, const at::Tensor& permutation, int64_t generation,
    int64_t kv_heads, int64_t block_size, double softmax_scale, at::Tensor& output,
    int64_t profile_mode) {
    TORCH_CHECK(query.dim() == 3 && query.size(0) == tables.size(0)
        && query.device() == key_cache.device() && query.scalar_type() == at::kBFloat16
        && query.is_contiguous() && output.sizes() == query.sizes()
        && output.scalar_type() == query.scalar_type() && output.device() == query.device()
        && output.is_contiguous(), "tile-fused attention needs contiguous BF16 Q/O");
    const int64_t dim = query.size(2), heads = query.size(1);
    check_packed_inputs(key_cache, tables, lengths, formats, offsets, scales,
                        generation, kv_heads, dim, block_size);
    check_tile_tables(key_cache, e4, e5, permutation, dim);
    TORCH_CHECK(value_cache.device() == query.device() && value_cache.scalar_type() == at::kByte
        && value_cache.dim() == 1 && value_cache.is_contiguous()
        && value_cache.numel() <= std::numeric_limits<uint32_t>::max(), "invalid fused V arena");
    TORCH_CHECK(generation >= 0 && generation <= 2 && heads > 0 && heads % kv_heads == 0
        && (dim == 128 || dim == 256) && block_size % 128 == 0
        && profile_mode >= 0 && profile_mode <= 1,
        "unsupported tile-fused geometry or profiling mode");
    const c10::DeviceGuard guard(query.device());
    auto stats = at::empty({profile_mode ? query.size(0) * heads : 0, 8},
                           query.options().dtype(at::kLong));
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    const uint32_t cores = static_cast<uint32_t>(std::min<int64_t>(40, query.size(0) * heads));
#define PSPKV_FUSED_ARGS \
        (GM_ADDR)query.const_data_ptr(), (GM_ADDR)key_cache.const_data_ptr(), \
        (GM_ADDR)value_cache.const_data_ptr(), (GM_ADDR)tables.const_data_ptr(), \
        (GM_ADDR)lengths.const_data_ptr(), (GM_ADDR)formats.const_data_ptr(), \
        (GM_ADDR)offsets.const_data_ptr(), (GM_ADDR)scales.const_data_ptr(), \
        (GM_ADDR)e4.const_data_ptr(), (GM_ADDR)e5.const_data_ptr(), \
        (GM_ADDR)permutation.const_data_ptr(), (GM_ADDR)output.mutable_data_ptr(), \
        (GM_ADDR)stats.mutable_data_ptr(), query.size(0), heads, kv_heads, dim, \
        block_size, tables.size(1), generation, static_cast<float>(softmax_scale)
    if (profile_mode) {
        PspkvTileFusedAttention<true><<<cores, nullptr, stream>>>(PSPKV_FUSED_ARGS);
    } else {
        PspkvTileFusedAttention<false><<<cores, nullptr, stream>>>(PSPKV_FUSED_ARGS);
    }
#undef PSPKV_FUSED_ARGS
    return stats;
}

}  // namespace psp_kv_ascend_native

TORCH_LIBRARY(psp_kv_ascend_native, m) {
    m.def("gather_paged_bf16_vec_out(Tensor key_cache, Tensor value_cache, Tensor block_tables, "
          "Tensor context_lens, Tensor formats, Tensor offsets, Tensor scales, Tensor e4, Tensor e5, "
          "Tensor permutation, int generation, int heads, int head_dim, int block_size, "
          "Tensor(a!) key_output, Tensor(b!) value_output) -> ()");
    m.def("rope_scatter_kv(Tensor(a!) query, Tensor key, Tensor value, Tensor positions, Tensor cos_sin, "
          "Tensor(b!) key_cache, Tensor(c!) value_cache, Tensor slots, Tensor formats, Tensor offsets, "
          "int block_size, int generation) -> ()");
    m.def("packed_scatter_kv(Tensor key, Tensor value, Tensor(a!) key_cache, Tensor(b!) value_cache, "
          "Tensor slots, Tensor formats, Tensor offsets, Tensor scales, int block_size, int generation) -> ()");
    m.def("tile_fused_attention(Tensor query, Tensor key_cache, Tensor value_cache, "
          "Tensor tables, Tensor lengths, Tensor formats, Tensor offsets, Tensor scales, "
          "Tensor e4, Tensor e5, Tensor permutation, int generation, int kv_heads, "
          "int block_size, float softmax_scale, Tensor(a!) output, int profile_mode) -> Tensor");
    m.def("gather_paged_bf16_vec(Tensor key_cache, Tensor value_cache, Tensor tables, Tensor lengths, "
          "Tensor formats, Tensor offsets, Tensor scales, Tensor e4, Tensor e5, Tensor permutation, "
          "int generation, int heads, int dim, int block_size) -> (Tensor, Tensor)");
    m.def("packed_scatter_parallel(Tensor prefill, Tensor(a!) key_cache, Tensor(b!) value_cache, "
          "Tensor slots, Tensor formats, Tensor offsets, Tensor scales, int block_size, int generation) -> ()");
    m.def("gather_paged_bf16(Tensor key_cache, Tensor value_cache, Tensor tables, Tensor lengths, "
          "Tensor formats, Tensor offsets, Tensor scales, int generation, int heads, int dim, int block_size) -> (Tensor, Tensor)");
    m.def("quantize_scatter_bf16(Tensor key, Tensor value, Tensor slots, "
          "Tensor formats, Tensor(a!) key_cache, Tensor(b!) value_cache) -> ()");
    m.def("decode_fp8(Tensor bytes, Tensor formats) -> Tensor");
    m.def("decode_scores_bf16(Tensor query, Tensor key_cache, Tensor formats, "
          "Tensor block_ids, int seq_len, float scale) -> Tensor");
    m.def("decode_weighted_value(Tensor probabilities, Tensor value_cache, "
          "Tensor formats, Tensor block_ids, int seq_len) -> Tensor");
    m.def("packed_scores(Tensor query, Tensor key_cache, Tensor block_tables, "
          "Tensor context_lens, Tensor formats, Tensor offsets, Tensor scales, "
          "int format_generation, int kv_heads, int block_size, float softmax_scale) -> Tensor");
    m.def("packed_weighted_value(Tensor probabilities, Tensor value_cache, "
          "Tensor block_tables, Tensor context_lens, Tensor formats, Tensor offsets, "
          "Tensor scales, int format_generation, int kv_heads, int head_dim, "
          "int block_size, int target_dtype) -> Tensor");
    m.def("packed_scores_vec(Tensor query, Tensor key_cache, Tensor block_tables, "
          "Tensor context_lens, Tensor formats, Tensor offsets, Tensor scales, "
          "Tensor e4m3_table, Tensor e5m2_table, Tensor fp4_table, "
          "int format_generation, int kv_heads, int block_size, float softmax_scale) -> Tensor");
    m.def("packed_weighted_value_vec(Tensor probabilities, Tensor value_cache, "
          "Tensor block_tables, Tensor context_lens, Tensor formats, Tensor offsets, "
          "Tensor scales, Tensor e4m3_table, Tensor e5m2_table, Tensor fp4_table, "
          "int format_generation, int kv_heads, int head_dim, "
          "int block_size, int target_dtype) -> Tensor");
    m.def("packed_fused_decode(Tensor query, Tensor key_cache, Tensor value_cache, "
          "Tensor block_tables, Tensor context_lens, Tensor formats, "
          "Tensor offsets, Tensor scales, int kv_heads, int block_size, "
          "float softmax_scale) -> Tensor");
    m.def("cast_fp8_output(Tensor source, Tensor(a!) output) -> ()");
    m.def("packed_scatter(Tensor prefill, Tensor(a!) key_cache, "
          "Tensor(b!) value_cache, Tensor slots, Tensor formats, Tensor offsets, "
          "Tensor(c!) scales, int num_tokens, int block_size, "
          "int format_generation, bool preserve_scales) -> ()");
    m.def("packed_dequant(Tensor key_cache, Tensor value_cache, Tensor offsets, "
          "Tensor formats, Tensor scales, int block_size, int head_dim, "
          "int target_dtype, int format_generation) -> (Tensor, Tensor)");
    m.def("uniform_scores(Tensor query, Tensor key_cache, Tensor block_tables, "
          "Tensor context_lens, float softmax_scale) -> Tensor");
    m.def("uniform_weighted_value(Tensor probabilities, Tensor value_cache, "
          "Tensor block_tables, Tensor context_lens, int target_dtype) -> Tensor");
}
