-// write and mixed E4M3/E5M2 cache attention. These are scalar kernels;
-// a tiled/vectorized implementation is still needed for throughput.
+// Ascend C PSP-KV codecs, reference kernels, tiled UB dequantization and
+// streaming SIMD attention. Scalar fallbacks preserve the wider mixed-format
+// contract; the FP8 tile paths avoid per-element scalar codec operations.
 
 #include <ATen/ATen.h>
 #include <c10/core/DeviceGuard.h>
@@ -11,6 +11,7 @@
 #include "torch_npu/csrc/core/npu/NPUStream.h"
 #include "kernel_operator.h"
 
+#include <algorithm>
 #include <cstdint>
 #include <limits>
 #include <tuple>
@@ -247,6 +248,8 @@ __aicore__ inline void WritePacked(AscendC::GlobalTensor<uint8_t>& source,
 
 // One logical element per loop iteration; the index arithmetic is explicit so
 // the kernel can be checked against vLLM's slot_mapping and physical block IDs.
+#include "pspkv_tiled.h"
+
 __global__ __vector__ void PspkvQuantizeScatterBF16(
     GM_ADDR key, GM_ADDR value, GM_ADDR slots, GM_ADDR formats,
     GM_ADDR key_cache, GM_ADDR value_cache,
@@ -691,6 +694,135 @@ __global__ __vector__ void PspkvPackedScatter(
     }
 }
 
+// Each job owns complete cache lines. Token/head K rows and Basic V rows
+// contain >=64 bytes even for FP4; transposed V jobs own a whole dimension
+// row (>=64 bytes). Slots must be unique within a call. Unit scales are
+// initialized by the caller instead of rewritten once per element.
+#include "pspkv_rope.h"
+
+template <bool SeparateKV = false>
+__global__ __vector__ void PspkvPackedScatterParallel(
+    GM_ADDR prefill, GM_ADDR value_source, GM_ADDR key_cache, GM_ADDR value_cache, GM_ADDR slot_mapping,
+    GM_ADDR formats, GM_ADDR offsets, GM_ADDR scales, uint32_t tokens,
+    uint32_t heads, uint32_t dimension, uint32_t block_size, uint32_t generation,
+    uint32_t key_token_stride, uint32_t key_head_stride,
+    uint32_t value_token_stride, uint32_t value_head_stride) {
+    AscendC::GlobalTensor<uint8_t> source, value_input, keys, values, codes;
+    AscendC::GlobalTensor<int64_t> slots;
+    AscendC::GlobalTensor<int32_t> byte_offsets;
+    AscendC::GlobalTensor<float> per_head_scales;
+    source.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(prefill));
+    value_input.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(value_source));
+    keys.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(key_cache));
+    values.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(value_cache));
+    codes.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(formats));
+    slots.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(slot_mapping));
+    byte_offsets.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(offsets));
+    per_head_scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scales));
+    const uint32_t key_jobs = tokens * heads;
+    const uint32_t value_jobs = generation == 0 ? key_jobs : heads * dimension;
+    for (uint32_t job = AscendC::GetBlockIdx(); job < key_jobs + value_jobs;
+         job += AscendC::GetBlockNum()) {
+        const bool key_job = job < key_jobs;
+        const uint32_t local = key_job ? job : job - key_jobs;
+        const bool token_major = key_job || generation == 0;
+        const uint32_t head = token_major ? local % heads : local / dimension;
+        const uint32_t count = token_major ? dimension : tokens;
+        for (uint32_t i = 0; i < count; ++i) {
+            const uint32_t token = token_major ? local / heads : i;
+            const uint32_t dim = token_major ? i : local % dimension;
+            const int64_t slot = slots.GetValue(token);
+            if (slot < 0) continue;
+            const uint32_t physical = static_cast<uint32_t>(slot / block_size);
+            const uint32_t within = static_cast<uint32_t>(slot % block_size);
+            const uint8_t code = codes.GetValue(physical);
+            const uint32_t per_head = PackedBytesPerHead(code, block_size, dimension, 0);
+            const uint32_t base = static_cast<uint32_t>(byte_offsets.GetValue(physical))
+                                  + head * per_head;
+            const uint32_t element = token_major ? within * dimension + dim
+                                                : dim * block_size + within;
+            const uint32_t src = SeparateKV
+                ? token * (key_job ? key_token_stride : value_token_stride)
+                  + head * (key_job ? key_head_stride : value_head_stride) + dim
+                : ((token * 2 + (key_job ? 0 : 1)) * heads + head) * dimension + dim;
+            const float scale = code == 3
+                ? per_head_scales.GetValue(physical * heads + head) : 1.0f;
+            if (key_job) WritePacked(source, keys, src, base, element, code, 0, scale);
+            else if (SeparateKV) WritePacked(value_input, values, src, base, element, code, 0, scale);
+            else WritePacked(source, values, src, base, element, code, 0, scale);
+        }
+    }
+}
