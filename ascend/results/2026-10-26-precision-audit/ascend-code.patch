@@ -0,0 +1,114 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Summarize adjacent, randomized before/after metadata-reuse request pairs."""
+
+import argparse
+import csv
+import json
+import math
+import random
+import statistics
+from pathlib import Path
+
+
+def percentile(values, fraction):
+    ordered = sorted(values)
+    pos = (len(ordered) - 1) * fraction
+    low, high = math.floor(pos), math.ceil(pos)
+    return ordered[low] + (ordered[high] - ordered[low]) * (pos - low)
+
+
+def paired_interval(pairs):
+    rng = random.Random(20261025)
+    samples = []
+    for _ in range(10000):
+        chosen = [pairs[rng.randrange(len(pairs))] for _ in pairs]
+        samples.append(
+            100 * (1 - sum(a for b, a in chosen) / sum(b for b, a in chosen))
+        )
+    return percentile(samples, 0.025), percentile(samples, 0.975)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--input-dir", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    rows, outputs = [], {}
+    baseline_path = args.input_dir / "stock-bf16-serving.json"
+    baseline = json.loads(baseline_path.read_text()) if baseline_path.exists() else None
+    for name in ("basic", "enhanced", "btkv"):
+        path = args.input_dir / f"{name}-serving.json"
+        if not path.exists():
+            continue
+        data = json.loads(path.read_text())
+        assert data["paired_metadata"]
+        outputs[name] = {}
+        for profile in ("short", "cross_page"):
+            records = [r for r in data["requests"] if r["profile"] == profile]
+            before = [r for r in records if not r["metadata_reuse"]]
+            after = [r for r in records if r["metadata_reuse"]]
+            by_pair = {}
+            for r in records:
+                by_pair.setdefault((r["round"], r["pair"]), {})[r["metadata_reuse"]] = r
+            assert all(len(pair) == 2 for pair in by_pair.values())
+            pairs = [
+                (v[False]["seconds"], v[True]["seconds"]) for v in by_pair.values()
+            ]
+            low, high = paired_interval(pairs)
+            b = statistics.median(r["seconds"] for r in before)
+            a = statistics.median(r["seconds"] for r in after)
+            reference = (
+                statistics.median(
+                    r["seconds"]
+                    for r in baseline["requests"]
+                    if r["profile"] == profile
+                )
+                if baseline
+                else None
+            )
+            equal = {r["text"] for r in before} == {r["text"] for r in after}
+            outputs[name][profile] = equal
+            rows.append(
+                {
+                    "format": name,
+                    "profile": profile,
+                    "pairs": len(pairs),
+                    "bf16_p50_s": reference,
+                    "before_p50_s": b,
+                    "after_p50_s": a,
+                    "p50_reduction_percent": 100 * (1 - a / b),
+                    "paired_mean_reduction_percent": 100
+                    * (1 - sum(a for b, a in pairs) / sum(b for b, a in pairs)),
+                    "paired_mean_bootstrap95_low": low,
+                    "paired_mean_bootstrap95_high": high,
+                    "before_p95_s": percentile([r["seconds"] for r in before], 0.95),
+                    "after_p95_s": percentile([r["seconds"] for r in after], 0.95),
+                    "before_tpot_ms": statistics.median(r["tpot_ms"] for r in before),
+                    "after_tpot_ms": statistics.median(r["tpot_ms"] for r in after),
+                    "before_ttft_ms": statistics.median(r["ttft_ms"] for r in before),
+                    "after_ttft_ms": statistics.median(r["ttft_ms"] for r in after),
+                    "output_text_equal": equal,
+                }
+            )
+    result = {
+        "rows": rows,
+        "output_text_equal": outputs,
+        "interval_scope": (
+            "Paired mean latency reduction, not the P50 reduction; "
+            "10000 paired bootstrap resamples, no cross-server/run confidence claim."
+        ),
+    }
+    (args.output_dir / "comparison.json").write_text(json.dumps(result, indent=2))
+    if rows:
+        with (args.output_dir / "comparison.csv").open("w", newline="") as stream:
+            writer = csv.DictWriter(stream, fieldnames=list(rows[0]))
+            writer.writeheader()
+            writer.writerows(rows)
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/ascend/summarize_pipeline_stages.py b/ascend/summarize_pipeline_stages.py
new file mode 100644
index 0000000..5a0c663
--- /dev/null
+++ b/ascend/summarize_pipeline_stages.py
@@ -0,0 +1,171 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Summarize matched model ablations and text/log-probability changes."""
+
+import argparse
+import csv
+import json
+import random
+import statistics
+from pathlib import Path
+
+
+def percentile(values, q):
+    values = sorted(values)
+    pos = (len(values) - 1) * q
+    low = int(pos)
+    return values[low] + (values[min(low + 1, len(values) - 1)] - values[low]) * (
+        pos - low
+    )
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--input-dir", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--exclude-formats", default="")
+    args = parser.parse_args()
+    rows, quality = [], []
+    for path in sorted(args.input_dir.glob("*-serving.json")):
+        name = path.name.removesuffix("-serving.json")
+        if name in args.exclude_formats.split(","):
+            continue
+        data = json.loads(path.read_text())
+        if "modes" not in data and data.get("paired_pipeline"):
+            after_level = data["after_level"]
+            data["modes"] = [0, after_level]
+            data["all_stage_texts_equal"] = data.get("pipeline_outputs_equal")
+            for row in data["requests"] + data["quality_probes"]:
+                row["pipeline_mode"] = after_level if row["pipeline_optimized"] else 0
+        if not data.get("all_stage_texts_equal"):
+            raise ValueError(f"missing or failed cross-stage output check: {name}")
+        for profile in data["profiles"]:
+            for mode in data["modes"]:
+                samples = [
+                    r
+                    for r in data["requests"]
+                    if r["profile"] == profile and r["pipeline_mode"] == mode
+                ]
+                baseline = [
+                    r
+                    for r in data["requests"]
+                    if r["profile"] == profile and r["pipeline_mode"] == 0
+                ]
+                by_pair = {(r["round"], r["pair"]): r for r in baseline}
+                pairs = [
+                    (by_pair[(r["round"], r["pair"])]["seconds"], r["seconds"])
+                    for r in samples
+                ]
+                rng = random.Random(20261026)
+                boot = []
+                for _ in range(10000):
+                    draw = rng.choices(pairs, k=len(pairs))
+                    boot.append(
+                        (1 - sum(b for a, b in draw) / sum(a for a, b in draw)) * 100
+                    )
+                median = statistics.median(r["seconds"] for r in samples)
+                base_median = statistics.median(r["seconds"] for r in baseline)
+                rows.append(
+                    {
+                        "format": name,
+                        "profile": profile,
+                        "input_tokens": data["prompt_token_counts"][profile],
+                        "mode": mode,
+                        "samples": len(samples),
+                        "p50_seconds": median,
+                        "p95_seconds": percentile(
+                            [r["seconds"] for r in samples], 0.95
+                        ),
+                        "ttft_p50_ms": statistics.median(r["ttft_ms"] for r in samples),
+                        "tpot_p50_ms": statistics.median(r["tpot_ms"] for r in samples),
+                        "p50_reduction_pct": (1 - median / base_median) * 100,
+                        "paired_mean_reduction_pct": (
+                            1 - sum(b for a, b in pairs) / sum(a for a, b in pairs)
+                        )
+                        * 100,
+                        "paired_mean_ci95_low": percentile(boot, 0.025),
+                        "paired_mean_ci95_high": percentile(boot, 0.975),
+                    }
+                )
+        comparisons = []
+        for mode in data["modes"]:
+            maximum = 0.0
+            changed_tokens = 0
+            compared_logprobs = 0
+            base = {
+                (r["profile"], r["round"], r["pair"]): r
+                for r in data["requests"]
+                if r["pipeline_mode"] == 0
+            }
+            for row in data["requests"]:
+                if row["pipeline_mode"] != mode:
+                    continue
+                original = base[(row["profile"], row["round"], row["pair"])]
+                if row["text"] != original["text"]:
+                    raise ValueError(f"paired generated text changed: {name}, {mode}")
+                if len(row.get("token_logprobs", [])) != len(
+                    original.get("token_logprobs", [])
+                ):
+                    raise ValueError(f"generated token count changed: {name}, {mode}")
+                for (a, ap), (b, bp) in zip(
+                    original.get("token_logprobs", []), row.get("token_logprobs", [])
+                ):
+                    changed_tokens += a != b
+                    if ap is not None and bp is not None:
+                        compared_logprobs += 1
+                        maximum = max(maximum, abs(ap - bp))
+            base_probes = {
+                r["prompt"]: r["response"]
+                for r in data["quality_probes"]
+                if r["pipeline_mode"] == 0
+            }
+            for probe in data["quality_probes"]:
+                if probe["pipeline_mode"] != mode:
+                    continue
+                observed = probe["response"]
+                original = base_probes[probe["prompt"]]
+                if observed["text"] != original["text"]:
+                    raise ValueError(f"quality probe changed: {name}, {mode}")
+                for (a, ap), (b, bp) in zip(
+                    original.get("token_logprobs", []),
+                    observed.get("token_logprobs", []),
+                ):
+                    changed_tokens += a != b
+                    if ap is not None and bp is not None:
+                        compared_logprobs += 1
+                        maximum = max(maximum, abs(ap - bp))
+            comparisons.append(
+                {
+                    "mode": mode,
+                    "max_generated_token_logprob_delta": maximum
+                    if compared_logprobs
+                    else None,
+                    "changed_generated_tokens": changed_tokens
+                    if compared_logprobs
+                    else None,
+                    "compared_logprobs": compared_logprobs,
+                }
+            )
+        quality.append(
+            {
+                "format": name,
+                "all_stage_texts_equal": True,
+                "quality_prompts": len({r["prompt"] for r in data["quality_probes"]}),
+                "quality_probe_requests": len(data["quality_probes"]),
+                "logprob_comparisons": comparisons,
+            }
+        )
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    (args.output_dir / "comparison.json").write_text(
+        json.dumps({"latency": rows, "quality": quality}, indent=2)
+    )
+    with (args.output_dir / "comparison.csv").open("w") as stream:
+        writer = csv.DictWriter(stream, fieldnames=list(rows[0]))
+        writer.writeheader()
+        writer.writerows(rows)
+    print(json.dumps({"groups": len(rows), "formats": len(quality)}))
+
+
+if __name__ == "__main__":
+    main()
