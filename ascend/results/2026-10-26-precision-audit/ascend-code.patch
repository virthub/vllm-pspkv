+// Gather only pages named by the live block table, never the entire arena.
+// Output is the native paged-attention layout [pages, block, KV head, dim].
+// Whole head rows are owned by one worker and copied via UB. Metadata and
+// layout arithmetic are hoisted out of the element loop; tail rows use SIMD.
+__global__ __vector__ void PspkvGatherPagedBF16(
+    GM_ADDR key_cache, GM_ADDR value_cache, GM_ADDR block_tables,
+    GM_ADDR context_lens, GM_ADDR formats, GM_ADDR offsets, GM_ADDR scales,
+    GM_ADDR key_output, GM_ADDR value_output, uint32_t seqs, uint32_t max_blocks,
+    uint32_t heads, uint32_t dimension, uint32_t block_size, uint32_t generation) {
+    AscendC::GlobalTensor<uint8_t> keys, values, codes;
+    AscendC::GlobalTensor<int32_t> tables, lengths, byte_offsets;
+    AscendC::GlobalTensor<float> per_head_scales;
+    AscendC::GlobalTensor<uint16_t> key_out, value_out;
+    keys.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(key_cache));
+    values.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(value_cache));
+    codes.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(formats));
+    tables.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(block_tables));
+    lengths.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(context_lens));
+    byte_offsets.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(offsets));
+    per_head_scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scales));
+    key_out.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(key_output));
+    value_out.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(value_output));
+    constexpr uint32_t MAX_DIM = 256;
+    const uint32_t rows = seqs * max_blocks * block_size * heads;
+    AscendC::TPipe pipe;
+    AscendC::TBuf<AscendC::TPosition::VECCALC> buffer;
+    pipe.InitBuffer(buffer, MAX_DIM * sizeof(uint16_t));
+    auto local = buffer.Get<uint16_t>();
+    for (uint32_t task = AscendC::GetBlockIdx(); task < 2 * rows;
+         task += AscendC::GetBlockNum()) {
+        const bool is_key = task < rows;
+        const uint32_t row = task % rows;
+        const uint32_t start = row * dimension;
+        const uint32_t head = row % heads;
+        uint32_t index = row / heads;
+        const uint32_t token = index % block_size; index /= block_size;
+        const uint32_t logical_block = index % max_blocks;
+        const uint32_t seq = index / max_blocks;
+        if (logical_block * block_size + token >= static_cast<uint32_t>(lengths.GetValue(seq))) {
+            AscendC::Duplicate(local, static_cast<uint16_t>(0), dimension);
+        } else {
+            const uint32_t physical = static_cast<uint32_t>(tables.GetValue(index));
+            const uint8_t code = codes.GetValue(physical);
+            const uint32_t per_head = PackedBytesPerHead(code, block_size, dimension, 0);
+            const uint32_t base = static_cast<uint32_t>(byte_offsets.GetValue(physical)) + head * per_head;
+            const float scale = code == 0 || generation == 0 ? 1.0f
+                : per_head_scales.GetValue(physical * heads + head);
+            for (uint32_t dim = 0; dim < dimension; ++dim) {
+                const uint32_t element = is_key || generation == 0
+                    ? token * dimension + dim : dim * block_size + token;
+                const float decoded = is_key
+                    ? ReadPacked(keys, base, element, code, 0, scale)
+                    : ReadPacked(values, base, element, code, 0, scale);
+                union { float f; uint32_t u; } bits;
+                bits.f = decoded;
+                // Match torch's FP32->BF16 round-to-nearest-even.
+                const uint32_t rounded = bits.u + 0x7fffU + ((bits.u >> 16) & 1U);
+                local.SetValue(dim, static_cast<uint16_t>(
+                    (bits.u & 0x7fffffffU) > 0x7f800000U
+                        ? (bits.u >> 16) | 0x40U : rounded >> 16));
+            }
+        }
+        pipe_barrier(PIPE_ALL);
+        if (is_key) AscendC::DataCopy(key_out[start], local, dimension);
+        else AscendC::DataCopy(value_out[start], local, dimension);
+        pipe_barrier(PIPE_ALL);
+    }
+}
