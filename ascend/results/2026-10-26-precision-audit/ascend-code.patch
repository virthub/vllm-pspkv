+        "vector gather scratch exceeds indexing limits");
+    for (const auto& tensor : {key, value}) {
+        TORCH_CHECK(tensor.device() == key_cache.device() && tensor.scalar_type() == at::kBFloat16
+            && tensor.is_contiguous() && tensor.dim() == 4 && tensor.size(0) == pages
+            && tensor.size(1) == block_size && tensor.size(2) == heads && tensor.size(3) == dim,
+            "vector gather outputs must be BF16 [active_pages,block,heads,dim]");
+    }
+    const c10::DeviceGuard guard(key_cache.device());
+    auto stream = c10_npu::getCurrentNPUStream().stream(true);
+    PspkvGatherPagedBF16Vec<<<40, nullptr, stream>>>(
+        (GM_ADDR)key_cache.const_data_ptr(), (GM_ADDR)value_cache.const_data_ptr(),
+        (GM_ADDR)tables.const_data_ptr(), (GM_ADDR)lengths.const_data_ptr(),
+        (GM_ADDR)formats.const_data_ptr(), (GM_ADDR)offsets.const_data_ptr(),
+        (GM_ADDR)scales.const_data_ptr(), (GM_ADDR)e4.const_data_ptr(),
+        (GM_ADDR)e5.const_data_ptr(), (GM_ADDR)permutation.const_data_ptr(),
+        (GM_ADDR)key.mutable_data_ptr(), (GM_ADDR)value.mutable_data_ptr(),
+        tables.size(0), tables.size(1), heads, dim, block_size, generation);
+}
+
+at::Tensor tile_fused_attention(
+    const at::Tensor& query, const at::Tensor& key_cache, const at::Tensor& value_cache,
+    const at::Tensor& tables, const at::Tensor& lengths, const at::Tensor& formats,
+    const at::Tensor& offsets, const at::Tensor& scales, const at::Tensor& e4,
+    const at::Tensor& e5, const at::Tensor& permutation, int64_t generation,
+    int64_t kv_heads, int64_t block_size, double softmax_scale, at::Tensor& output,
+    int64_t profile_mode) {
+    TORCH_CHECK(query.dim() == 3 && query.size(0) == tables.size(0)
+        && query.device() == key_cache.device() && query.scalar_type() == at::kBFloat16
+        && query.is_contiguous() && output.sizes() == query.sizes()
+        && output.scalar_type() == query.scalar_type() && output.device() == query.device()
+        && output.is_contiguous(), "tile-fused attention needs contiguous BF16 Q/O");
+    const int64_t dim = query.size(2), heads = query.size(1);
+    check_packed_inputs(key_cache, tables, lengths, formats, offsets, scales,
+                        generation, kv_heads, dim, block_size);
+    check_tile_tables(key_cache, e4, e5, permutation, dim);
+    TORCH_CHECK(value_cache.device() == query.device() && value_cache.scalar_type() == at::kByte
+        && value_cache.dim() == 1 && value_cache.is_contiguous()
+        && value_cache.numel() <= std::numeric_limits<uint32_t>::max(), "invalid fused V arena");
+    TORCH_CHECK(generation >= 0 && generation <= 2 && heads > 0 && heads % kv_heads == 0
+        && (dim == 128 || dim == 256) && block_size % 128 == 0
+        && profile_mode >= 0 && profile_mode <= 1,
+        "unsupported tile-fused geometry or profiling mode");
+    const c10::DeviceGuard guard(query.device());
+    auto stats = at::empty({profile_mode ? query.size(0) * heads : 0, 8},
+                           query.options().dtype(at::kLong));
+    auto stream = c10_npu::getCurrentNPUStream().stream(true);
+    const uint32_t cores = static_cast<uint32_t>(std::min<int64_t>(40, query.size(0) * heads));
+#define PSPKV_FUSED_ARGS \
+        (GM_ADDR)query.const_data_ptr(), (GM_ADDR)key_cache.const_data_ptr(), \
+        (GM_ADDR)value_cache.const_data_ptr(), (GM_ADDR)tables.const_data_ptr(), \
+        (GM_ADDR)lengths.const_data_ptr(), (GM_ADDR)formats.const_data_ptr(), \
+        (GM_ADDR)offsets.const_data_ptr(), (GM_ADDR)scales.const_data_ptr(), \
+        (GM_ADDR)e4.const_data_ptr(), (GM_ADDR)e5.const_data_ptr(), \
+        (GM_ADDR)permutation.const_data_ptr(), (GM_ADDR)output.mutable_data_ptr(), \
+        (GM_ADDR)stats.mutable_data_ptr(), query.size(0), heads, kv_heads, dim, \
+        block_size, tables.size(1), generation, static_cast<float>(softmax_scale)
+    if (profile_mode) {
+        PspkvTileFusedAttention<true><<<cores, nullptr, stream>>>(PSPKV_FUSED_ARGS);
+    } else {
+        PspkvTileFusedAttention<false><<<cores, nullptr, stream>>>(PSPKV_FUSED_ARGS);
+    }
+#undef PSPKV_FUSED_ARGS
+    return stats;
+}
+
