+        // PV: acc += prob @ V_tile
+        load_matrix_sync(pa, s_prob, 16);
+        #pragma unroll
+        for (int nt8 = 0; nt8 < NT8; nt8++) {
+            load_matrix_sync(vb, sv[cur] + nt8 * 16, HEAD_DIM);
+            mma_sync(acc[nt8], pa, vb, acc[nt8]);
+        }
+        __syncthreads();
+    }
