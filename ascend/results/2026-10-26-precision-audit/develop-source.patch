+                } else {
+                    acc[nt8].x[2] *= rescale_old; acc[nt8].x[3] *= rescale_old;
+                    acc[nt8].x[6] *= rescale_old; acc[nt8].x[7] *= rescale_old;
+                }
+            }
+        }
