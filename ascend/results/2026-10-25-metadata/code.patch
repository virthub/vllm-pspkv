+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Order-balanced adjacent metadata A/B pairs on the same loaded model."""
+
+import argparse
+import json
+import random
+import time
+import urllib.error
+import urllib.request
+from pathlib import Path
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--port", type=int, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--control-file", type=Path, required=True)
+    parser.add_argument("--rounds", type=int, default=3)
+    parser.add_argument("--requests-per-profile", type=int, default=4)
+    parser.add_argument("--warmups", type=int, default=2)
+    parser.add_argument("--model", default="Qwen/Qwen3-0.6B")
+    parser.add_argument("--ready-timeout", type=int, default=600)
+    args = parser.parse_args()
+    base = f"http://127.0.0.1:{args.port}"
+    model = args.model
+
+    def post(path, payload):
+        request = urllib.request.Request(
+            base + path,
+            data=json.dumps(payload).encode(),
+            headers={"Content-Type": "application/json"},
+        )
+        with urllib.request.urlopen(request, timeout=180) as response:
+            return json.load(response)
+
+    deadline = time.monotonic() + args.ready_timeout
+    while time.monotonic() < deadline:
+        try:
+            with urllib.request.urlopen(base + "/health", timeout=3):
+                break
+        except (OSError, urllib.error.URLError):
+            time.sleep(3)
+    else:
+        raise RuntimeError("server readiness timed out")
+    long_text = (
+        "请阅读记录，最后用中文回答中国的首都是哪里。\n"
+        + "记录：北京是中国的首都，上海是中国的城市。\n" * 20
+        + "\n中国的首都是"
+    )
+    tokens = post("/tokenize", {"model": model, "prompt": long_text})["tokens"]
+    profiles = {"short": "北京是中国的", "cross_page": tokens[:120] + tokens[-15:]}
+    prompt_counts = {
+        "short": len(
+            post("/tokenize", {"model": model, "prompt": profiles["short"]})["tokens"]
+        ),
+        "cross_page": 135,
+    }
+    data = {
+        "model": model,
+        "rounds": args.rounds,
+        "requests_per_profile_per_round": args.requests_per_profile,
+        "warmups_per_profile": args.warmups,
+        "output_tokens": 32,
+        "concurrency": 1,
+        "profiles": profiles,
+        "prompt_token_counts": prompt_counts,
+        "requests": [],
+        "paired_metadata": True,
+    }
+
+    def generate(prompt):
+        payload = {
+            "model": model,
+            "prompt": prompt,
+            "max_tokens": 32,
+            "temperature": 0,
+            "seed": 123,
+            "ignore_eos": True,
+            "stream": True,
+            "stream_options": {"include_usage": True},
+        }
+        request = urllib.request.Request(
+            base + "/v1/completions",
+            data=json.dumps(payload).encode(),
+            headers={"Content-Type": "application/json"},
+        )
+        started = time.perf_counter()
+        first = last = None
+        text, usage = "", None
+        with urllib.request.urlopen(request, timeout=180) as response:
+            for line in response:
+                if not line.startswith(b"data: "):
+                    continue
+                event = line[6:].strip()
+                if event == b"[DONE]":
+                    break
+                chunk = json.loads(event)
+                if "error" in chunk:
+                    raise RuntimeError(chunk["error"])
+                if chunk.get("usage"):
+                    usage = chunk["usage"]
+                for choice in chunk.get("choices", []):
+                    piece = choice.get("text", "")
+                    if piece:
+                        last = time.perf_counter()
+                        first = first if first is not None else last
+                        text += piece
+        ended = time.perf_counter()
+        assert usage is not None and usage["completion_tokens"] == 32
+        assert first is not None and last is not None
+        return {
+            "seconds": ended - started,
+            "ttft_ms": (first - started) * 1000,
+            "tpot_ms": (last - first) * 1000 / 31,
+            "usage": usage,
+            "text": text,
+        }
+
+    def select_mode(enabled):
+        # The server reads once per ForwardContext, before any attention layer.
+        args.control_file.write_text("1" if enabled else "0")
+
+    for prompt in profiles.values():
+        for enabled in (False, True):
+            select_mode(enabled)
+            for _ in range(args.warmups):
+                generate(prompt)
+    ordering = random.Random(20261023)
+    for round_index in range(args.rounds):
+        schedule = list(profiles) * args.requests_per_profile
+        ordering.shuffle(schedule)
+        for pair, profile in enumerate(schedule):
+            modes = [False, True]
+            ordering.shuffle(modes)
+            for enabled in modes:
+                select_mode(enabled)
+                row = generate(profiles[profile])
+                row.update(
+                    {
+                        "profile": profile,
+                        "round": round_index,
+                        "pair": pair,
+                        "metadata_reuse": enabled,
+                    }
+                )
+                assert row["usage"]["prompt_tokens"] == prompt_counts[profile]
+                data["requests"].append(row)
+                args.output.write_text(json.dumps(data, ensure_ascii=False, indent=2))
+                print(
+                    json.dumps(
+                        {
+                            k: row[k]
+                            for k in (
+                                "profile",
+                                "round",
+                                "pair",
+                                "metadata_reuse",
+                                "seconds",
+                                "ttft_ms",
+                            )
+                        }
+                    ),
+                    flush=True,
+                )
+    data["quality_probes"] = []
+    for enabled in (False, True):
+        select_mode(enabled)
+        for prompt in ("1+1=", "The capital of France is"):
+            data["quality_probes"].append(
+                {
+                    "prompt": prompt,
+                    "metadata_reuse": enabled,
+                    "response": generate(prompt),
+                }
+            )
+    for profile in profiles:
+        before = {
+            r["text"]
+            for r in data["requests"]
+            if r["profile"] == profile and not r["metadata_reuse"]
+        }
+        after = {
+            r["text"]
+            for r in data["requests"]
+            if r["profile"] == profile and r["metadata_reuse"]
+        }
+        assert before == after, (profile, "metadata reuse changed generated output")
+    data["metadata_outputs_equal"] = True
+    args.output.write_text(json.dumps(data, ensure_ascii=False, indent=2))
+
+
+if __name__ == "__main__":
+    main()
