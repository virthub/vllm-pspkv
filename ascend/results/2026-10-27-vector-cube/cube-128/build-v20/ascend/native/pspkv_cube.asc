#include <ATen/ATen.h>
#include <c10/core/DeviceGuard.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "kernel_operator.h"
#include "matmul/matmul_intf.h"
#include "matmul/matmul_tiling.h"
#include <algorithm>
#include <limits>

__aicore__ inline float DecodeFP4(uint8_t code) {
  const float lut[8] = {
      0, .5f, 1, 1.5f, 2, 3, __builtin_inff(), __builtin_nanf("")};
  return (code & 8) ? -lut[code & 7] : lut[code & 7];
}
__aicore__ inline uint32_t PackedBytesPerHead(uint8_t code, uint32_t b,
                                              uint32_t d, uint32_t) {
  return code == 0 ? b * d * 2 : code == 3 ? b * d / 2 : b * d;
}
__aicore__ inline float ReadPacked(AscendC::GlobalTensor<uint8_t>& src,
                                   uint32_t base, uint32_t e, uint8_t code,
                                   uint32_t, float scale) {
  if (code == 3)
    return DecodeFP4((src.GetValue(base + e / 2) >> (e % 2 * 4)) & 15) * scale;
  union {
    uint32_t u;
    float f;
  } x;
  x.u = static_cast<uint32_t>(src.GetValue(base + 2 * e) |
                              (src.GetValue(base + 2 * e + 1) << 8))
        << 16;
  return x.f;
}
#define PSPKV_TILE_DECODER_ONLY
#include "pspkv_tiled.h"
#undef PSPKV_TILE_DECODER_ONLY
#define PspkvMergeSplits PspkvCubeMergeSplits
#include "pspkv_split.h"
#undef PspkvMergeSplits

using CubeA =
    AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, bfloat16_t>;
using CubeBK = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND,
                                   bfloat16_t, true>;
using CubeC =
    AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
// Runtime tiling is generated on the host by the installed SDK.
constexpr auto PSPKV_CUBE_CFG = GetNormalConfig();
// On A2, explicit bounded GM tiles bridge Vector UB and Cube L1.
// No full-context BF16 cache is allocated; one decode serves a whole GQA group.
__global__ __mix__(1, 2) void PspkvCubeAttention(
    GM_ADDR query, GM_ADDR keys, GM_ADDR values, GM_ADDR tables,
    GM_ADDR lengths, GM_ADDR codes, GM_ADDR offsets, GM_ADDR scales, GM_ADDR e4,
    GM_ADDR e5, GM_ADDR permutation, GM_ADDR partials,
    __kfc_workspace__ GM_ADDR workspace, uint32_t seqs, uint32_t heads,
    uint32_t kv_heads, uint32_t max_blocks, uint32_t splits,
    float softmax_scale, AscendC::tiling::TCubeTiling tq) {
  AscendC::TPipe pipe;
  AscendC::TBuf<AscendC::TPosition::VECCALC> qStageBuf, kStageBuf, vStageBuf,
      pStageBuf;
  pipe.InitBuffer(qStageBuf, 16 * 128 * 2);
  pipe.InitBuffer(kStageBuf, 128 * 128 * 2);
  pipe.InitBuffer(vStageBuf, 128 * 128 * 2);
  pipe.InitBuffer(pStageBuf, 16 * 128 * 2);
  AscendC::Matmul<CubeA, CubeBK, CubeC, CubeC, PSPKV_CUBE_CFG> qk;
  REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), qk, &tq);
  if (AscendC::GetSubBlockIdx() != 0) return;
  auto qStage = qStageBuf.Get<bfloat16_t>(),
       kStage = kStageBuf.Get<bfloat16_t>();
  auto vStage = vStageBuf.Get<bfloat16_t>(),
       pStage = pStageBuf.Get<bfloat16_t>();
  PspkvTileDecoder decoder;
  decoder.Init(pipe, 128, e4, e5, permutation, true, true);
  AscendC::TBuf<AscendC::TPosition::VECCALC> sBuf, oBuf, aBuf, rBuf, hBuf;
  pipe.InitBuffer(sBuf, 16 * 128 * 4);
  pipe.InitBuffer(oBuf, 16 * 128 * 4);
  pipe.InitBuffer(aBuf, 16 * 128 * 4);
  pipe.InitBuffer(rBuf, 2048);
  pipe.InitBuffer(hBuf, 64);
  auto q = qStage, p = pStage;
  auto s = sBuf.Get<float>(), o = oBuf.Get<float>(), acc = aBuf.Get<float>();
  auto reduce = rBuf.Get<float>(), header = hBuf.Get<float>();
  AscendC::GlobalTensor<bfloat16_t> gq;
  gq.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(query));
  AscendC::GlobalTensor<uint8_t> gk, gv, gc;
  gk.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(keys));
  gv.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(values));
  gc.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(codes));
  AscendC::GlobalTensor<int32_t> gt, gl, go;
  gt.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(tables));
  gl.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(lengths));
  go.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(offsets));
  AscendC::GlobalTensor<float> gs, gpart;
  gs.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scales));
  gpart.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(partials));
  AscendC::GlobalTensor<bfloat16_t> qa, ka, va, pa;
  AscendC::GlobalTensor<float> so, oo;
  // The compiler advances the marked argument past the 16 MiB system area;
  // GetSysWorkSpacePtr() still addresses that system area. Do not add it twice.
  auto tile_base =
      workspace +
      (AscendC::GetBlockIdx() / AscendC::GetTaskRation()) * 96 * 1024;
  qa.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(tile_base));
  ka.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(tile_base + 4096));
  va.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(tile_base + 36864));
  pa.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(tile_base + 69632));
  so.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(tile_base + 73728));
  oo.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(tile_base + 81920));
  const uint32_t group = heads / kv_heads;
  for (uint32_t job = AscendC::GetBlockIdx() / AscendC::GetTaskRation();
       job < seqs * kv_heads * splits; job += AscendC::GetBlockNum()) {
    uint32_t split = job % splits, kh = job / splits % kv_heads,
             seq = job / (splits * kv_heads);
    uint32_t length = gl.GetValue(seq), pages = (length + 127) / 128;
    uint32_t begin = pages * split / splits, end = pages * (split + 1) / splits;
    float maxima[16], denoms[16];
    for (uint32_t h = 0; h < 16; ++h) {
      maxima[h] = -3.402823466e38f;
      denoms[h] = 0;
    }
    AscendC::Duplicate(acc, 0.0f, 16 * 128);
    AscendC::Duplicate(q.ReinterpretCast<uint16_t>(), static_cast<uint16_t>(0),
                       16 * 128);
    AscendC::DataCopy(q, gq[(seq * heads + kh * group) * 128], group * 128);
    pipe_barrier(PIPE_ALL);
    AscendC::DataCopy(qa, qStage, 16 * 128);
    pipe_barrier(PIPE_ALL);
    for (uint32_t page = begin; page < end; ++page) {
      uint32_t physical = gt.GetValue(seq * max_blocks + page);
      uint8_t code = gc.GetValue(physical);
      uint32_t base =
          go.GetValue(physical) + kh * PackedBytesPerHead(code, 128, 128, 0);
      float scale = code == 0 ? 1.0f : gs.GetValue(physical * kv_heads + kh);
      for (uint32_t t = 0; t < 128; t += 32) {
        auto kd =
            decoder.Round(decoder.Load(gk, base, code, scale, t, 128, false));
        uint32_t valid = length - page * 128;
        valid = valid < 128 ? valid : 128;
        if (t + 32 > valid) {
          uint32_t keep = valid > t ? valid - t : 0;
          AscendC::Duplicate(kd[keep * 128].ReinterpretCast<uint16_t>(),
                             static_cast<uint16_t>(0), (32 - keep) * 128);
          pipe_barrier(PIPE_ALL);
        }
        AscendC::DataCopy(kStage[t * 128], kd, 32 * 128);
        pipe_barrier(PIPE_ALL);
        auto vd =
            decoder.Round(decoder.Load(gv, base, code, scale, t, 128, false));
        if (t + 32 > valid) {
          uint32_t keep = valid > t ? valid - t : 0;
          AscendC::Duplicate(vd[keep * 128].ReinterpretCast<uint16_t>(),
                             static_cast<uint16_t>(0), (32 - keep) * 128);
          pipe_barrier(PIPE_ALL);
        }
        AscendC::DataCopy(vStage[t * 128], vd, 32 * 128);
        pipe_barrier(PIPE_ALL);
      }
      AscendC::DataCopy(ka, kStage, 128 * 128);
      AscendC::DataCopy(va, vStage, 128 * 128);
      pipe_barrier(PIPE_ALL);
      qk.SetOrgShape(16, 128, 128);
      qk.SetTensorA(qa);
      qk.SetTensorB(ka, true);
      qk.template IterateAll<true>(so);
      qk.End();
      pipe_barrier(PIPE_ALL);
      AscendC::DataCopy(s, so, 16 * 128);
      pipe_barrier(PIPE_ALL);
      AscendC::Duplicate(p.ReinterpretCast<uint16_t>(),
                         static_cast<uint16_t>(0), 16 * 128);
      for (uint32_t h = 0; h < group; ++h) {
        auto row = s[h * 128];
        AscendC::Muls(row, row, softmax_scale, 128);
        uint32_t valid = length - page * 128;
        valid = valid < 128 ? valid : 128;
        for (uint32_t tail = valid; tail < 128; ++tail)
          row.SetValue(tail, -3.402823466e38f);
        pipe_barrier(PIPE_V);
        AscendC::ReduceMax(reduce, row, reduce[128], 128, false);
        pipe_barrier(PIPE_ALL);
        float m = reduce.GetValue(0);
        m = m > maxima[h] ? m : maxima[h];
        header.SetValue(0, maxima[h] - m);
        pipe_barrier(PIPE_ALL);
        AscendC::Exp(header, header, 1);
        pipe_barrier(PIPE_ALL);
        float alpha = header.GetValue(0);
        maxima[h] = m;
        AscendC::Adds(row, row, -m, 128);
        pipe_barrier(PIPE_V);
        AscendC::Exp(row, row, 128);
        pipe_barrier(PIPE_V);
        AscendC::ReduceSum(reduce, row, reduce[128], 128);
        pipe_barrier(PIPE_ALL);
        denoms[h] = denoms[h] * alpha + reduce.GetValue(0);
        AscendC::Muls(acc[h * 128], acc[h * 128], alpha, 128);
        AscendC::Cast(p[h * 128], row, AscendC::RoundMode::CAST_RINT, 128);
        pipe_barrier(PIPE_ALL);
      }
      pipe_barrier(PIPE_ALL);
      AscendC::DataCopy(pa, pStage, 16 * 128);
      pipe_barrier(PIPE_ALL);
      qk.SetOrgShape(16, 128, 128);
      qk.SetTensorA(pa);
      qk.SetTensorB(va, false);
      qk.template IterateAll<true>(oo);
      qk.End();
      pipe_barrier(PIPE_ALL);
      AscendC::DataCopy(o, oo, 16 * 128);
      pipe_barrier(PIPE_ALL);
      AscendC::Add(acc, acc, o, group * 128);
      pipe_barrier(PIPE_ALL);
    }
    for (uint32_t h = 0; h < group; ++h) {
      header.SetValue(0, maxima[h]);
      header.SetValue(1, denoms[h]);
      pipe_barrier(PIPE_ALL);
      uint32_t dst = ((seq * heads + kh * group + h) * splits + split) * 144;
      AscendC::DataCopy(gpart[dst], header, 16);
      AscendC::DataCopy(gpart[dst + 16], acc[h * 128], 128);
      pipe_barrier(PIPE_ALL);
    }
  }
}

AscendC::tiling::TCubeTiling pspkv_make_tiling(bool transpose) {
  matmul_tiling::PlatformInfo platform;
  platform.socVersion = platform_ascendc::SocVersion::ASCEND910B;
  platform.l1Size = 512 * 1024;
  platform.l0CSize = 128 * 1024;
  platform.ubSize = 192 * 1024;
  platform.l0ASize = 64 * 1024;
  platform.l0BSize = 64 * 1024;
  matmul_tiling::MatmulApiTiling api(platform);
  api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
               matmul_tiling::DataType::DT_BFLOAT16);
  api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
               matmul_tiling::DataType::DT_BFLOAT16, transpose);
  api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
               matmul_tiling::DataType::DT_FLOAT);
  api.SetShape(16, 128, 128);
  api.SetOrgShape(16, 128, 128);
  api.SetFixSplit(16, 128, 128);
  api.SetBufferSpace(512 * 1024, 128 * 1024, 16 * 1024);
  AscendC::tiling::TCubeTiling tiling{};
  TORCH_CHECK(api.GetTiling(tiling) == 0, "Cube tiling failed");
  return tiling;
}
void pspkv_cube_attention(const at::Tensor& query, const at::Tensor& keys,
                          const at::Tensor& values, const at::Tensor& tables,
                          const at::Tensor& lengths, const at::Tensor& codes,
                          const at::Tensor& offsets, const at::Tensor& scales,
                          const at::Tensor& e4, const at::Tensor& e5,
                          const at::Tensor& permutation, at::Tensor& output,
                          at::Tensor& workspace, int64_t splits, double scale) {
  TORCH_CHECK(query.device().type() == c10::DeviceType::PrivateUse1 &&
                  query.is_contiguous() && query.dim() == 3 &&
                  query.size(2) == 128 && query.scalar_type() == at::kBFloat16,
              "Cube requires contiguous BF16 queries, dim 128");
  TORCH_CHECK(tables.scalar_type() == at::kInt &&
                  lengths.scalar_type() == at::kInt &&
                  codes.scalar_type() == at::kByte &&
                  offsets.scalar_type() == at::kInt && scales.dim() == 2,
              "Invalid Cube metadata");
  int64_t kv_heads = scales.size(1), heads = query.size(1),
          seqs = query.size(0);
  TORCH_CHECK(seqs > 0 && heads > 0 && kv_heads > 0 && heads % kv_heads == 0 &&
                  heads / kv_heads <= 16 && splits >= 1 && splits <= 32,
              "Unsupported GQA group/splits");
  TORCH_CHECK(
      workspace.scalar_type() == at::kByte &&
          workspace.numel() >=
              20 * 1024 * 1024 + seqs * heads * splits * 144 * 4 &&
          permutation.numel() == 4608,
      "Cube requires system/tile/partial workspace and an extended FP4 LUT");
  for (const auto* tensor : std::initializer_list<const at::Tensor*>{
           &keys, &values, &tables, &lengths, &codes, &offsets, &scales, &e4,
           &e5, &permutation, &output, &workspace}) {
    TORCH_CHECK(tensor->device() == query.device() && tensor->is_contiguous(),
                "Cube inputs, output and workspace must share an NPU and be "
                "contiguous");
  }
  TORCH_CHECK(keys.dim() == 1 && keys.scalar_type() == at::kByte &&
                  values.scalar_type() == at::kByte &&
                  values.sizes() == keys.sizes() && tables.dim() == 2 &&
                  tables.size(0) == seqs && lengths.numel() == seqs &&
                  codes.dim() == 1 && offsets.sizes() == codes.sizes() &&
                  scales.size(0) == codes.numel() &&
                  scales.scalar_type() == at::kFloat &&
                  e4.scalar_type() == at::kFloat && e4.numel() >= 256 &&
                  e5.scalar_type() == at::kFloat && e5.numel() >= 256 &&
                  permutation.scalar_type() == at::kInt &&
                  output.sizes() == query.sizes() &&
                  output.scalar_type() == at::kBFloat16,
              "Invalid Cube cache, lookup table or output shape/type");
  const c10::DeviceGuard guard(query.device());
  // Keep split outputs in caller-owned storage throughout graph capture and
  // replay; no per-layer allocator activity or temporary Tensor lifetime.
  auto partials =
      static_cast<uint8_t*>(workspace.mutable_data_ptr()) + 20 * 1024 * 1024;
  auto stream = c10_npu::getCurrentNPUStream().stream(true);
  static const auto tq = pspkv_make_tiling(true);
  PspkvCubeAttention<<<std::min<int64_t>(20, seqs * kv_heads * splits), nullptr,
                       stream>>>(
      (GM_ADDR)query.const_data_ptr(), (GM_ADDR)keys.const_data_ptr(),
      (GM_ADDR)values.const_data_ptr(), (GM_ADDR)tables.const_data_ptr(),
      (GM_ADDR)lengths.const_data_ptr(), (GM_ADDR)codes.const_data_ptr(),
      (GM_ADDR)offsets.const_data_ptr(), (GM_ADDR)scales.const_data_ptr(),
      (GM_ADDR)e4.const_data_ptr(), (GM_ADDR)e5.const_data_ptr(),
      (GM_ADDR)permutation.const_data_ptr(), (GM_ADDR)partials,
      (GM_ADDR)workspace.mutable_data_ptr(), seqs, heads, kv_heads,
      tables.size(1), splits, static_cast<float>(scale), tq);
  PspkvCubeMergeSplits<<<std::min<int64_t>(40, seqs * heads), nullptr,
                         stream>>>((GM_ADDR)partials,
                                   (GM_ADDR)output.mutable_data_ptr(),
                                   seqs * heads, 128, splits);
}
TORCH_LIBRARY(psp_kv_ascend_cube, m) {
  m.def(
      "attention(Tensor query, Tensor keys, Tensor values, Tensor tables, "
      "Tensor lengths, Tensor codes, Tensor offsets, Tensor scales, Tensor e4, "
      "Tensor e5, Tensor permutation, Tensor(a!) output, Tensor(b!) workspace, "
      "int splits, float scale) -> ()");
}
TORCH_LIBRARY_IMPL(psp_kv_ascend_cube, PrivateUse1, m) {
  m.impl("attention", TORCH_FN(pspkv_cube_attention));
}
