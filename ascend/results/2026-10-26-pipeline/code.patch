+        assert usage is not None and usage["completion_tokens"] == 32
+        assert first is not None and last is not None
+        return {
+            "seconds": ended - started,
+            "ttft_ms": (first - started) * 1000,
+            "tpot_ms": (last - first) * 1000 / 31,
